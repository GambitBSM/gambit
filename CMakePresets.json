  "configurePresets": [
    {
      "name": "gambit-base",
      "description": "Shared full GAMBIT profile. MPI defaults to OFF. Uses the canonical build/ directory; use --fresh when switching profiles or compilers.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Bits": "",
        "itch": "",
        "CBS_BUILD_PRESET": {
          "type": "STRING",
          "value": ""
        },
        "GAMBIT_BUILD_PRESET": {
          "type": "STRING",
          "value": ""
        },
        "WITH_MPI": {
          "type": "BOOL",
          "value": "OFF"
        },
        "WITH_RESTFRAMES": {
          "type": "BOOL",
          "value": "OFF"
        },
        "WITH_ONNXRUNTIME": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CUTFLOW": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CBS_AUTO_DETECT_PYTHON": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CBS_AUTO_DETECT_ROOT": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CBS_WITH_RIVET_CONTUR": {
          "type": "BOOL",
          "value": "OFF"
        }
      },
      "hidden": true
    },
    {
      "name": "cbs-base",
      "hidden": true,
      "description": "Shared CBS cache. Enable CBS analysis capabilities, including HDF5. The selected preset and compiler persist in build/; use --fresh when switching from GAMBIT or between compiler families.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "Bits": "ColliderBit",
        "CBS_AUTO_DETECT_PYTHON": {
          "type": "BOOL",
          "value": "ON"
        },
        "CBS_AUTO_DETECT_ROOT": {
          "type": "BOOL",
          "value": "ON"
        },
        "CBS_WITH_RIVET_CONTUR": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_BUILD_TYPE": "Release",
        "CUTFLOW": {
          "type": "BOOL",
          "value": "ON"
        },
        "WITH_HDF5": {
          "type": "BOOL",
          "value": "ON"
        },
        "WITH_ONNXRUNTIME": {
          "type": "BOOL",
          "value": "ON"
        },
        "WITH_RESTFRAMES": {
          "type": "BOOL",
          "value": "ON"
        },
        "WITH_SQLite3": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "gambit-llvm",
      "inherits": "gambit-base",
      "displayName": "GAMBIT - Upstream LLVM (macOS / Linux)",
      "vendor": {
        "gambit/bootstrap/1": {
          "system": "gambit",
          "toolchain": "llvm"
        }
      },
      "description": "Release GAMBIT using Upstream LLVM (macOS / Linux). All presets share build/; use --fresh when switching profiles or compilers.",
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Darwin"
          },
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          }
        ]
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/llvm-native.cmake",
      "cacheVariables": {
        "GAMBIT_PRESET_TOOLCHAIN": {
          "type": "STRING",
          "value": "llvm"
        },
        "GAMBIT_BUILD_PRESET": {
          "type": "STRING",
          "value": "gambit-llvm"
        }
      }
    },
