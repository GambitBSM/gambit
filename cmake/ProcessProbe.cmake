# Reuse explicitly read-only command queries within one CMake process only.
# GLOBAL properties are never written to CMakeCache.txt or passed to children.
include_guard(GLOBAL)

function(_gambit_probe_field output value)
  string(LENGTH "${value}" _length)
  set(${output} "${${output}}${_length}:${value}" PARENT_SCOPE)
endfunction()

function(gambit_process_probe_key output)
  cmake_parse_arguments(PARSE_ARGV 1 _probe "" "WORKING_DIRECTORY;TIMEOUT" "COMMAND;INPUT_FILES")
  set(_key "GAMBIT read-only process probe v1")
  foreach(_argument IN LISTS _probe_COMMAND)
    _gambit_probe_field(_key "${_argument}")
  endforeach()
  if(_probe_WORKING_DIRECTORY)
    _gambit_probe_field(_key "cwd:${_probe_WORKING_DIRECTORY}")
  else()
    _gambit_probe_field(_key "cwd:${CMAKE_CURRENT_BINARY_DIR}")
  endif()
  _gambit_probe_field(_key "timeout:${_probe_TIMEOUT}")
  foreach(_environment PATH CC CXX FC SDKROOT DEVELOPER_DIR LANG LC_ALL LC_MESSAGES
      HOME PYTHONPATH PYTHONHOME PYTHONNOUSERSITE PYTHONUSERBASE PYTHONSAFEPATH
      VIRTUAL_ENV CONDA_PREFIX PYENV_VERSION PYENV_DIR PYENV_ROOT)
    _gambit_probe_field(_key "${_environment}=$ENV{${_environment}}")
  endforeach()
  set(_files ${_probe_INPUT_FILES})
  if(_probe_COMMAND)
    list(GET _probe_COMMAND 0 _program)
    list(APPEND _files "${_program}")
  endif()
  list(REMOVE_DUPLICATES _files)
  foreach(_file IN LISTS _files)
    if(IS_ABSOLUTE "${_file}")
      _gambit_probe_field(_key "file:${_file}")
      if(EXISTS "${_file}" AND NOT IS_DIRECTORY "${_file}")
        get_filename_component(_real "${_file}" REALPATH)
        file(SIZE "${_file}" _size)
        file(TIMESTAMP "${_file}" _modified "%Y-%m-%dT%H:%M:%S" UTC)
        _gambit_probe_field(_key "${_real}:${_size}:${_modified}")
        if(_file IN_LIST _probe_INPUT_FILES)
          file(SHA256 "${_file}" _hash)
          _gambit_probe_field(_key "${_hash}")
        endif()
      else()
        _gambit_probe_field(_key missing)
      endif()
    endif()
  endforeach()
  string(SHA256 _key "${_key}")
  set(${output} "${_key}" PARENT_SCOPE)
endfunction()

function(gambit_process_probe)
  cmake_parse_arguments(PARSE_ARGV 0 _probe
    "OUTPUT_STRIP_TRAILING_WHITESPACE;ERROR_STRIP_TRAILING_WHITESPACE;ERROR_QUIET"
    "RESULT_VARIABLE;OUTPUT_VARIABLE;ERROR_VARIABLE;TIMEOUT;WORKING_DIRECTORY"
    "COMMAND;INPUT_FILES")
  if(NOT _probe_COMMAND OR _probe_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Invalid read-only process probe: ${_probe_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT _probe_TIMEOUT)
    set(_probe_TIMEOUT 10)
  endif()
  set(_key_working_directory "")
  if(_probe_WORKING_DIRECTORY)
    set(_key_working_directory WORKING_DIRECTORY "${_probe_WORKING_DIRECTORY}")
  endif()
  gambit_process_probe_key(_key COMMAND ${_probe_COMMAND}
    INPUT_FILES ${_probe_INPUT_FILES} TIMEOUT "${_probe_TIMEOUT}" ${_key_working_directory})
  set(_property "GAMBIT_PROCESS_PROBE_${_key}")
  get_property(_known GLOBAL PROPERTY "${_property}_RESULT" SET)
  if(_known)
    get_property(_result GLOBAL PROPERTY "${_property}_RESULT")
    get_property(_stdout GLOBAL PROPERTY "${_property}_STDOUT")
    get_property(_stderr GLOBAL PROPERTY "${_property}_STDERR")
  else()
    set(_working_directory "")
    if(_probe_WORKING_DIRECTORY)
      set(_working_directory WORKING_DIRECTORY "${_probe_WORKING_DIRECTORY}")
    endif()
    execute_process(COMMAND ${_probe_COMMAND} ${_working_directory}
      TIMEOUT "${_probe_TIMEOUT}" RESULT_VARIABLE _result
      OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    set_property(GLOBAL PROPERTY "${_property}_RESULT" "${_result}")
    set_property(GLOBAL PROPERTY "${_property}_STDOUT" "${_stdout}")
    set_property(GLOBAL PROPERTY "${_property}_STDERR" "${_stderr}")
  endif()
  if(_probe_OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REGEX REPLACE "[ \t\r\n]+$" "" _stdout "${_stdout}")
  endif()
  if(_probe_ERROR_STRIP_TRAILING_WHITESPACE)
    string(REGEX REPLACE "[ \t\r\n]+$" "" _stderr "${_stderr}")
  endif()
  foreach(_output RESULT_VARIABLE OUTPUT_VARIABLE ERROR_VARIABLE)
    if(_probe_${_output})
      if(_output STREQUAL "RESULT_VARIABLE")
        set(${_probe_${_output}} "${_result}" PARENT_SCOPE)
      elseif(_output STREQUAL "OUTPUT_VARIABLE")
        set(${_probe_${_output}} "${_stdout}" PARENT_SCOPE)
      else()
        set(${_probe_${_output}} "${_stderr}" PARENT_SCOPE)
      endif()
    endif()
  endforeach()
endfunction()
