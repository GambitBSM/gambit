# Script-only policy tests. No project(), compiler probe, configure or build.
cmake_minimum_required(VERSION 3.16.3)
include("${CMAKE_CURRENT_LIST_DIR}/../CXXStandard.cmake")

function(expect_equal actual expected)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Expected '${expected}', got '${actual}'")
  endif()
endfunction()

if(DEFINED FAILURE_CASE)
  set(PERMIT_CXX17_PLUS_CHECK TRUE)
  set(CMAKE_CXX_COMPILE_FEATURES cxx_std_17 cxx_std_20 cxx_std_23)
  set(CMAKE_CXX_FLAGS "")
  if(FAILURE_CASE STREQUAL "old_standard")
    set(CMAKE_CXX_STANDARD 14)
  elseif(FAILURE_CASE STREQUAL "future_standard")
    set(CMAKE_CXX_STANDARD 26)
  elseif(FAILURE_CASE STREQUAL "unsupported_compiler")
    set(CMAKE_CXX_COMPILE_FEATURES cxx_std_17)
    set(CMAKE_CXX_STANDARD 20)
  elseif(FAILURE_CASE STREQUAL "unsupported_minimum")
    set(CMAKE_CXX_COMPILE_FEATURES cxx_std_14)
  elseif(FAILURE_CASE STREQUAL "blocked_combination")
    set(PERMIT_CXX17_PLUS_CHECK FALSE)
    set(COMPILER_SUPPORTS_CXX23 TRUE CACHE INTERNAL "old result")
  elseif(FAILURE_CASE STREQUAL "conflicting_flags")
    set(CMAKE_CXX_STANDARD 17)
    set(CMAKE_CXX_FLAGS "-O2 -std=gnu++20")
  elseif(FAILURE_CASE STREQUAL "conflicting_configurations")
    set(CMAKE_CXX_FLAGS_DEBUG "-std=c++17")
    set(CMAKE_CXX_FLAGS_RELEASE "-std=c++20")
  elseif(FAILURE_CASE STREQUAL "invalid_flag")
    set(CMAKE_CXX_FLAGS "-std=c++invalid")
  elseif(FAILURE_CASE STREQUAL "old_cmake_23")
    set(CMAKE_VERSION 3.16.3)
    set(CMAKE_CXX_STANDARD 23)
  elseif(FAILURE_CASE STREQUAL "root_mismatch")
    set(CMAKE_CXX_STANDARD 17)
  elseif(FAILURE_CASE STREQUAL "root_unsupported")
    set(CMAKE_CXX_COMPILE_FEATURES cxx_std_17)
  else()
    message(FATAL_ERROR "Unknown test case ${FAILURE_CASE}")
  endif()
  gambit_initialise_cxx_standard()
  if(FAILURE_CASE MATCHES "^root_")
    gambit_match_root_cxx_standard(20)
  endif()
  message(FATAL_ERROR "Test did not reject invalid configuration")
endif()

function(check_selection features request flags root expected)
  set(PERMIT_CXX17_PLUS_CHECK TRUE)
  set(CMAKE_CXX_COMPILE_FEATURES "${features}")
  set(CMAKE_CXX_STANDARD "${request}")
  set(CMAKE_CXX_FLAGS "${flags}")
  gambit_initialise_cxx_standard()
  expect_equal("${CMAKE_CXX_FLAGS}" "-Wall")
  # These snapshots exist before ROOT discovery in the real configure path.
  set(BACKEND_CXX_FLAGS "-O2 -std=c++${GAMBIT_CXX_STANDARD}")
  set(BACKEND_CXX_FLAGS_NO_BUILD_OPTIMISATIONS "-fPIC -std=c++${GAMBIT_CXX_STANDARD}")
  set(BACKEND_CXX_FLAGS_PLUS_MPI "-DUSE_MPI -std=c++${GAMBIT_CXX_STANDARD}")
  if(root)
    gambit_match_root_cxx_standard("${root}")
  else()
    gambit_sync_backend_cxx_standard()
  endif()
  expect_equal("${GAMBIT_CXX_STANDARD}" "${expected}")
  expect_equal("${CMAKE_CXX_STANDARD}" "${expected}")
  expect_equal("${CMAKE_CXX_STANDARD_REQUIRED}" "ON")
  expect_equal("${CMAKE_CXX_EXTENSIONS}" "OFF")
  expect_equal("${GAMBIT_SUPPORTS_CXX14}" "TRUE")
  expect_equal("${GAMBIT_SUPPORTS_CXX17}" "TRUE")
  expect_equal("${BACKEND_CXX_FLAGS}" "-O2 -std=c++${expected}")
  expect_equal("${BACKEND_CXX_FLAGS_NO_BUILD_OPTIMISATIONS}" "-fPIC -std=c++${expected}")
  expect_equal("${BACKEND_CXX_FLAGS_PLUS_MPI}" "-DUSE_MPI -std=c++${expected}")
  if(request STREQUAL "" AND flags STREQUAL "-Wall")
    expect_equal("${GAMBIT_CXX_STANDARD_REQUESTED}" "AUTO")
  endif()
endfunction()

set(all_features cxx_std_17 cxx_std_20 cxx_std_23)
check_selection("${all_features}" "" "-Wall" "" 23)
check_selection("cxx_std_17;cxx_std_20" "" "-Wall" "" 20)
check_selection("cxx_std_17" "" "-Wall" "" 17)
foreach(standard 17 20 23)
  check_selection("${all_features}" "${standard}" "-Wall" "" "${standard}")
  check_selection("${all_features}" "" "-Wall" "${standard}" "${standard}")
  check_selection("${all_features}" "${standard}" "-Wall" "${standard}" "${standard}")
endforeach()
check_selection("${all_features}" "" "-Wall -std=gnu++2a" 20 20)
check_selection("${all_features}" "17" "-Wall -std=c++1z" 17 17)
check_selection("${all_features}" "" "-std=c++17 -std=gnu++2b -Wall" "" 23)

gambit_cxx_standard_from_flags("-O2 -std=c++17\t-std=gnu++2a" parsed)
expect_equal("${parsed}" 20)
gambit_cxx_standard_from_flags("-O2" parsed)
expect_equal("${parsed}" "")
gambit_normalise_cxx_standard(" 2b " parsed)
expect_equal("${parsed}" 23)
gambit_set_cxx_standard_flag("-std=gnu++23 -std=c++20 -O3" 14 flags)
expect_equal("${flags}" "-O3 -std=c++14")

set(failure_cases old_standard future_standard unsupported_compiler unsupported_minimum
    blocked_combination conflicting_flags conflicting_configurations invalid_flag
    old_cmake_23 root_mismatch root_unsupported)
foreach(case IN LISTS failure_cases)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DFAILURE_CASE=${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR error MATCHES "Test did not reject|Unknown test case")
    message(FATAL_ERROR "Failure case '${case}' failed to exercise rejection: ${output}${error}")
  endif()
  if(NOT error MATCHES "supports C\\+\\+17|cannot enable C\\+\\+|requires a compiler|cannot use C\\+\\+17|already selected|requires CMake 3.20|ROOT was built")
    message(FATAL_ERROR "Unexpected error in '${case}': ${error}")
  endif()
endforeach()
message(STATUS "C++ standard policy checks passed (15 selections, 4 parsers, 11 rejected configurations).")
