#ifndef __restframes_variables_hpp__
#define __restframes_variables_hpp__

/// Leave out RestFrames
#cmakedefine EXCLUDE_RESTFRAMES 1

/// RestFrames include path, retained even when RestFrames is disabled
#cmakedefine RESTFRAMES_INCLUDE "@RESTFRAMES_INCLUDE@"

#endif // __restframes_variables_hpp__
