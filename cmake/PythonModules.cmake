# Shared batch imports for ordinary GAMBIT, public presets and bootstrap.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ProcessProbe.cmake")
set_property(GLOBAL PROPERTY GAMBIT_PYTHON_MODULE_PROBE_SCRIPT
  "${CMAKE_CURRENT_LIST_DIR}/scripts/python_modules.py")
if(NOT CMAKE_SCRIPT_MODE_FILE)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_LIST_DIR}/scripts/python_modules.py")
endif()

function(_gambit_python_module_context executable output)
  get_property(_script GLOBAL PROPERTY GAMBIT_PYTHON_MODULE_PROBE_SCRIPT)
  gambit_process_probe_key(_context COMMAND "${executable}" -B "${_script}"
    INPUT_FILES "${_script}")
  set(${output} "GAMBIT_PYTHON_MODULE_${_context}" PARENT_SCOPE)
endfunction()

function(_gambit_python_store_records context requested text)
  string(REPLACE "\n" ";" _records "${text}")
  foreach(_record IN LISTS _records)
    if(_record MATCHES "^([A-Za-z_][A-Za-z0-9_.]*)\t([01])\t([-0-9.]+)\t([01])$")
      set(_module "${CMAKE_MATCH_1}")
      set(_found "${CMAKE_MATCH_2}")
      set(_hdf5 "${CMAKE_MATCH_3}")
      set(_metadata_error "${CMAKE_MATCH_4}")
      if(_module IN_LIST requested)
        set_property(GLOBAL PROPERTY "${context}_${_module}_FOUND" "${_found}")
        set_property(GLOBAL PROPERTY "${context}_${_module}_HDF5" "${_hdf5}")
        set_property(GLOBAL PROPERTY "${context}_${_module}_METADATA_ERROR" "${_metadata_error}")
      endif()
    endif()
  endforeach()
endfunction()

function(gambit_probe_python_modules executable)
  _gambit_python_module_context("${executable}" _context)
  set(_missing "")
  foreach(_module IN LISTS ARGN)
    if(NOT _module MATCHES "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$")
      message(FATAL_ERROR "Invalid Python module name: ${_module}")
    endif()
    get_property(_known GLOBAL PROPERTY "${_context}_${_module}_FOUND" SET)
    if(NOT _known)
      list(APPEND _missing "${_module}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _missing)
  if(NOT _missing)
    return()
  endif()
  get_property(_script GLOBAL PROPERTY GAMBIT_PYTHON_MODULE_PROBE_SCRIPT)
  list(LENGTH _missing _count)
  math(EXPR _timeout "10 * ${_count}")
  gambit_process_probe(COMMAND "${executable}" -B "${_script}" ${_missing}
    INPUT_FILES "${_script}" TIMEOUT "${_timeout}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _text ERROR_QUIET)
  _gambit_python_store_records("${_context}" "${_missing}" "${_text}")
  # A crash/timeout can leave a partial batch. Keep completed records and isolate
  # only unreported modules; one bad optional import must not hide the others.
  foreach(_module IN LISTS _missing)
    get_property(_known GLOBAL PROPERTY "${_context}_${_module}_FOUND" SET)
    if(NOT _known)
      if(_count GREATER 1)
        gambit_process_probe(COMMAND "${executable}" -B "${_script}" "${_module}"
          INPUT_FILES "${_script}" TIMEOUT 10
          RESULT_VARIABLE _result OUTPUT_VARIABLE _text ERROR_QUIET)
        _gambit_python_store_records("${_context}" "${_module}" "${_text}")
      endif()
      get_property(_known GLOBAL PROPERTY "${_context}_${_module}_FOUND" SET)
      if(NOT _known)
        set_property(GLOBAL PROPERTY "${_context}_${_module}_FOUND" 0)
        set_property(GLOBAL PROPERTY "${_context}_${_module}_HDF5" "-")
        set_property(GLOBAL PROPERTY "${_context}_${_module}_METADATA_ERROR" 0)
      endif()
    endif()
  endforeach()
endfunction()

function(gambit_python_module_status executable module output_found output_hdf5 output_metadata_error)
  gambit_probe_python_modules("${executable}" "${module}")
  _gambit_python_module_context("${executable}" _context)
  foreach(_field FOUND HDF5 METADATA_ERROR)
    get_property(_${_field} GLOBAL PROPERTY "${_context}_${module}_${_field}")
  endforeach()
  set(${output_found} "${_FOUND}" PARENT_SCOPE)
  set(${output_hdf5} "${_HDF5}" PARENT_SCOPE)
  set(${output_metadata_error} "${_METADATA_ERROR}" PARENT_SCOPE)
endfunction()
