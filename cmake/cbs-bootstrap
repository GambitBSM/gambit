#!/bin/sh
# Author: Pengxuan Zhu <pengxuan.zhu@adelaide.edu.au>
# Date: 2026 Aug
#
# Read-only CBS environment bootstrap.
#
# This intentionally performs discovery only. Configure and build continue to
# use CMake's native preset commands after the user has selected a strategy.

set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
probe="${script_dir}/presets/detect-cbs-presets.cmake"

if [ "$#" -ne 0 ]; then
  printf '%s\n' \
    'Usage: ./cmake/cbs-bootstrap' \
    '' \
    'This read-only CBS environment probe accepts no arguments.' >&2
  exit 2
fi

exec cmake -P "${probe}"
