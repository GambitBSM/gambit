# Final build summary for configurations selected through a GAMBIT preset.

include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/PresetFeatureSummary.cmake")

function(gambit_print_build_summary)
  if(CBS_PRESET_BUILD OR NOT GAMBIT_PRESET_TOOLCHAIN)
    return()
  endif()

  if(GAMBIT_BUILD_PRESET)
    set(_preset "${GAMBIT_BUILD_PRESET}")
  elseif(GAMBIT_PRESET_TOOLCHAIN STREQUAL "llvm")
    set(_preset "gambit-llvm")
  elseif(GAMBIT_PRESET_TOOLCHAIN STREQUAL "macos")
    set(_preset "gambit")
  elseif(GAMBIT_PRESET_TOOLCHAIN STREQUAL "gnu")
    set(_preset "gambit-gnu")
  else()
    set(_preset "gambit-${GAMBIT_PRESET_TOOLCHAIN}")
  endif()
  if(_preset MATCHES "^darkbit-wimp")
    set(_heading "DarkBit WIMP build summary")
  elseif(_preset MATCHES "^darkbit-mssm")
    set(_heading "DarkBit MSSM build summary")
  elseif(_preset MATCHES "^darkbit-singlet-z2")
    set(_heading "DarkBit scalar singlet Z2 build summary")
  else()
    set(_heading "GAMBIT build summary")
  endif()

  set(_bits_text "none")
  if(GAMBIT_BITS)
    string(REPLACE ";" ", " _bits_text "${GAMBIT_BITS}")
  endif()
  set(_interface_count "not trimmed")
  if(GAMBIT_TRIM_BACKEND_INTERFACES AND GAMBIT_TRIM_TOTAL_COUNT)
    set(_interface_count "${GAMBIT_TRIM_USED_COUNT} of ${GAMBIT_TRIM_TOTAL_COUNT} kept")
  endif()

  message(STATUS "")
  message(STATUS "================================================================")
  message(STATUS "                       ${_heading}")
  message(STATUS "----------------------------------------------------------------")
  cbs_summary_line("Preset" "${_preset}")
  if(GAMBIT_RESOLVED_TOOLCHAIN STREQUAL "llvm")
    cbs_summary_line("Toolchain" "upstream LLVM ${GAMBIT_RESOLVED_LLVM_VERSION}")
    cbs_summary_line("LLVM root" "${GAMBIT_RESOLVED_LLVM_ROOT}")
  elseif(GAMBIT_RESOLVED_TOOLCHAIN STREQUAL "macos")
    cbs_summary_line("Toolchain" "macOS AppleClang")
  elseif(GAMBIT_RESOLVED_TOOLCHAIN STREQUAL "gnu")
    cbs_summary_line("Toolchain" "Linux GNU")
  else()
    cbs_summary_line("Toolchain" "system environment")
  endif()
  cbs_summary_line("C" "${CMAKE_C_COMPILER_ID} ${CMAKE_C_COMPILER_VERSION}  (${CMAKE_C_COMPILER})")
  cbs_summary_line("C++" "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}  (${CMAKE_CXX_COMPILER})")
  cbs_summary_line("C++ standard" "${GAMBIT_CXX_STANDARD} (${GAMBIT_CXX_STANDARD_REASON}; requested ${GAMBIT_CXX_STANDARD_REQUESTED})")
  cbs_summary_line("Fortran" "${CMAKE_Fortran_COMPILER_ID} ${CMAKE_Fortran_COMPILER_VERSION}  (${CMAKE_Fortran_COMPILER})")
  if(Python3_Interpreter_FOUND)
    cbs_summary_line("Python" "CPython ${Python3_VERSION}  (${Python3_EXECUTABLE})")
  endif()
  if(OPENMP_FOUND OR FOUND_BREW_OPENMP OR GAMBIT_MACOS_HOMEBREW_LLVM_OPENMP)
    cbs_summary_line("OpenMP" "enabled")
  else()
    cbs_summary_line("OpenMP" "unavailable")
  endif()
  cbs_summary_line("Bits" "${_bits_text}")
  cbs_summary_line("Backends" "${_interface_count}")
  preset_print_feature_groups()
  cbs_summary_line("Build tree" "${CMAKE_BINARY_DIR}")
  message(STATUS "================================================================")
endfunction()
