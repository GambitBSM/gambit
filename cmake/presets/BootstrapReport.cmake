# Presentation only: keep probe policy in the availability/discovery modules.
# Buffer the report, then emit it once on stdout for clean shell redirection.

include_guard(GLOBAL)

function(bootstrap_report_line text)
  if("${text}" STREQUAL "")
    get_property(_report_current GLOBAL PROPERTY BOOTSTRAP_REPORT)
    if(_report_current MATCHES "\n\n$")
      return()
    endif()
  endif()
  set_property(GLOBAL APPEND_STRING PROPERTY BOOTSTRAP_REPORT "${text}\n")
endfunction()

function(bootstrap_report_style text style output)
  if(BOOTSTRAP_COLOR)
    string(ASCII 27 _report_escape)
    set(${output} "${_report_escape}[${style}m${text}${_report_escape}[0m" PARENT_SCOPE)
  else()
    set(${output} "${text}" PARENT_SCOPE)
  endif()
endfunction()

function(bootstrap_report_section title)
  bootstrap_report_line("")
  bootstrap_report_style("${title}" "1;36" _report_title)
  bootstrap_report_line("  ${_report_title}")
  string(REPEAT "─" 64 _report_rule)
  bootstrap_report_style("  ${_report_rule}" 2 _report_rule)
  bootstrap_report_line("${_report_rule}")
endfunction()

function(bootstrap_report_pad text width output)
  string(LENGTH "${text}" _report_length)
  math(EXPR _report_padding "${width} - ${_report_length}")
  if(_report_padding GREATER 0)
    string(REPEAT " " ${_report_padding} _report_spaces)
  else()
    set(_report_spaces " ")
  endif()
  set(${output} "${text}${_report_spaces}" PARENT_SCOPE)
endfunction()

function(bootstrap_report_dependency label found detail)
  bootstrap_report_pad("${label}" 16 _report_label)
  if(found)
    bootstrap_report_style("FOUND  " 32 _report_status)
  else()
    bootstrap_report_style("MISSING" 33 _report_status)
  endif()
  bootstrap_report_line("    ${_report_label} ${_report_status}  ${detail}")
endfunction()

function(bootstrap_report_path label path)
  if(BOOTSTRAP_VERBOSE AND NOT "${path}" STREQUAL "")
    bootstrap_report_style("      ${label}: ${path}" 2 _report_path)
    bootstrap_report_line("${_report_path}")
  endif()
endfunction()

function(bootstrap_report_header systems count)
  bootstrap_report_style("GAMBIT  /  Preset discovery" 1 _report_title)
  bootstrap_report_line("")
  bootstrap_report_line("  ${_report_title}")
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(_report_host macOS)
  else()
    set(_report_host "${CMAKE_HOST_SYSTEM_NAME}")
  endif()
  string(JOIN ", " _report_systems ${systems})
  string(TOUPPER "${_report_systems}" _report_systems)
  if(count EQUAL 1)
    set(_report_count "1 preset")
  else()
    set(_report_count "${count} presets")
  endif()
  bootstrap_report_line("  ${_report_systems} · ${_report_host} · CMake ${CMAKE_VERSION} · ${_report_count}")
endfunction()

function(bootstrap_report_preset name strategy display_name host_reason list_only)
  string(REGEX REPLACE "^[A-Za-z0-9_]+ - " "" _report_toolchain "${display_name}")
  get_property(_report_available GLOBAL PROPERTY BOOTSTRAP_${name}_AVAILABLE)
  get_property(_report_reasons GLOBAL PROPERTY BOOTSTRAP_${name}_REASONS)
  if(host_reason)
    set(_report_status "OTHER HOST")
    set(_report_style 2)
  elseif(list_only)
    set(_report_status "NOT PROBED")
    set(_report_style 2)
  elseif(_report_available)
    set(_report_status "AVAILABLE")
    set(_report_style 32)
  else()
    set(_report_status "UNAVAILABLE")
    set(_report_style 31)
  endif()
  bootstrap_report_pad("${name}" 18 _report_name)
  bootstrap_report_pad("${_report_status}" 13 _report_status)
  bootstrap_report_style("${_report_status}" "${_report_style}" _report_status)
  bootstrap_report_line("    ${_report_name}${_report_status}${_report_toolchain}")
  if(NOT list_only AND NOT host_reason)
    get_property(_report_c GLOBAL PROPERTY BOOTSTRAP_${name}_C)
    get_property(_report_cxx GLOBAL PROPERTY BOOTSTRAP_${name}_CXX)
    get_property(_report_fortran GLOBAL PROPERTY BOOTSTRAP_${name}_FORTRAN)
    get_property(_report_root GLOBAL PROPERTY BOOTSTRAP_${name}_LLVM_ROOT)
    cbs_classify_compiler("${_report_c}" _report_c_id _report_c_version _report_unused)
    cbs_classify_compiler("${_report_cxx}" _report_cxx_id _report_cxx_version _report_unused)
    cbs_classify_compiler("${_report_fortran}" _report_fortran_id _report_fortran_version _report_unused)
    foreach(_report_language c cxx fortran)
      if(_report_${_report_language}_id)
        set(_report_${_report_language}_description "${_report_${_report_language}_id} ${_report_${_report_language}_version}")
      elseif(_report_${_report_language})
        get_filename_component(_report_${_report_language}_description "${_report_${_report_language}}" NAME)
      else()
        set(_report_${_report_language}_description "not found")
      endif()
    endforeach()
    if(_report_c_id AND _report_cxx_id AND _report_c_id STREQUAL _report_cxx_id AND
       _report_c_version STREQUAL _report_cxx_version)
      bootstrap_report_line("      C/C++ ${_report_cxx_description} · Fortran ${_report_fortran_description}")
    else()
      bootstrap_report_line("      C ${_report_c_description} · C++ ${_report_cxx_description}")
      bootstrap_report_line("      Fortran ${_report_fortran_description}")
    endif()
    bootstrap_report_path(C "${_report_c}")
    bootstrap_report_path(C++ "${_report_cxx}")
    bootstrap_report_path(Fortran "${_report_fortran}")
    bootstrap_report_path("LLVM root" "${_report_root}")
  endif()
  if(host_reason)
    bootstrap_report_line("      ${host_reason}")
  else()
    foreach(_report_reason IN LISTS _report_reasons)
      string(STRIP "${_report_reason}" _report_reason)
      bootstrap_report_line("      ${_report_reason}")
    endforeach()
  endif()
  bootstrap_report_line("")
endfunction()

function(bootstrap_report_environment)
  bootstrap_report_section("Shared environment")
  if(BOOTSTRAP_PYTHON_FOUND)
    set(_report_python "CPython ${BOOTSTRAP_PYTHON_VERSION}")
  else()
    set(_report_python "Python 3 interpreter")
  endif()
  bootstrap_report_dependency(Python "${BOOTSTRAP_PYTHON_FOUND}" "${_report_python}")
  bootstrap_report_path(Python "${BOOTSTRAP_PYTHON_EXECUTABLE}")
  bootstrap_report_dependency(PyYAML "${BOOTSTRAP_PYTHON_HAS_YAML}" "Python yaml module")
  bootstrap_report_dependency(Boost "${BOOTSTRAP_BOOST_FOUND}" "headers")
  bootstrap_report_path(Boost "${BOOTSTRAP_BOOST_PATH}")
  bootstrap_report_dependency(Eigen "${BOOTSTRAP_EIGEN_FOUND}" "headers")
  bootstrap_report_path(Eigen "${BOOTSTRAP_EIGEN_PATH}")
  bootstrap_report_dependency(GSL "${BOOTSTRAP_GSL_FOUND}" "development package")
  bootstrap_report_path(GSL "${BOOTSTRAP_GSL_PATH}")
  if(BOOTSTRAP_HDF5_DESCRIPTION MATCHES "^/")
    get_filename_component(_report_hdf5 "${BOOTSTRAP_HDF5_DESCRIPTION}" NAME)
  else()
    set(_report_hdf5 "${BOOTSTRAP_HDF5_DESCRIPTION}")
  endif()
  bootstrap_report_dependency("HDF5 C" "${BOOTSTRAP_HDF5_FOUND}" "${_report_hdf5}")
  bootstrap_report_path("HDF5 C" "${BOOTSTRAP_HDF5_DESCRIPTION}")
  string(REGEX REPLACE " \\(.*\\)$" "" _report_openmp "${BOOTSTRAP_OPENMP_DESCRIPTION}")
  bootstrap_report_dependency(OpenMP "${BOOTSTRAP_OPENMP_FOUND}" "${_report_openmp}")
  bootstrap_report_path(OpenMP "${BOOTSTRAP_OPENMP_DESCRIPTION}")
endfunction()

function(bootstrap_report_commands names source_dir)
  bootstrap_report_section("Build commands · choose one preset")
  bootstrap_report_line("    Run from ${source_dir}")
  bootstrap_report_line("    Examples use 8 parallel jobs; adjust to your CPU and memory.")
  bootstrap_report_line("")
  foreach(_report_name IN LISTS names)
    bootstrap_report_style("${_report_name}" 1 _report_name_styled)
    bootstrap_report_line("    ${_report_name_styled}")
    bootstrap_report_line("      cmake --preset ${_report_name} --fresh")
    bootstrap_report_line("      cmake --build --preset ${_report_name} --parallel 8")
    bootstrap_report_line("")
  endforeach()
endfunction()

function(bootstrap_report_finish available unavailable other_host list_only)
  if(list_only)
    bootstrap_report_style("  Registry only · environment not probed" 2 _report_footer)
    bootstrap_report_line("${_report_footer}")
  else()
    bootstrap_report_line("  ${available} available · ${unavailable} unavailable · ${other_host} other host")
    bootstrap_report_style("  Discovery only; configure validates compile/link." 2 _report_footer)
    bootstrap_report_line("${_report_footer}")
    bootstrap_report_style("  Shared build/ · use --fresh when switching profiles or compilers." 2 _report_footer)
    bootstrap_report_line("${_report_footer}")
    if(NOT BOOTSTRAP_VERBOSE)
      bootstrap_report_style("  Full paths: add --verbose" 2 _report_footer)
      bootstrap_report_line("${_report_footer}")
    endif()
  endif()
  get_property(_report_text GLOBAL PROPERTY BOOTSTRAP_REPORT)
  string(REGEX REPLACE "\n$" "" _report_text "${_report_text}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_report_text}")
endfunction()
