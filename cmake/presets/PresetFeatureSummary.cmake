# Feature flags grouped by the module that decides them.
# ColliderBit and SpecBit packages follow those modules. Flags that stay
# independent of any one physics module are listed as common.

include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/CBSValidation.cmake")

function(_preset_bit_enabled bit_name output)
  if(";${GAMBIT_BITS};" MATCHES ";${bit_name};")
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()

# External packages that this build will compile or link. Modules and
# internal switches keep the separate status word "enabled".
function(_preset_included_text output version_text)
  set(_text "included")
  if(NOT "${version_text}" STREQUAL "")
    string(APPEND _text " (${version_text})")
  endif()
  set(${output} "${_text}" PARENT_SCOPE)
endfunction()

# A package that is compiled exactly when its module is enabled.
function(_preset_module_package output module_name module_on excluded version_text)
  if(NOT module_on)
    set(${output} "off with ${module_name}" PARENT_SCOPE)
    return()
  endif()
  if(excluded)
    set(${output} "disabled" PARENT_SCOPE)
    return()
  endif()
  _preset_included_text(_text "${version_text}")
  set(${output} "${_text}" PARENT_SCOPE)
endfunction()

function(preset_print_feature_groups)
  cmake_parse_arguments(PARSE_ARGV 0 _groups "CBS_BACKENDS" "" "")

  _preset_bit_enabled("ColliderBit" _collider)
  _preset_bit_enabled("SpecBit" _spec)

  _preset_module_package(_hepmc "ColliderBit" "${_collider}" "${EXCLUDE_HEPMC}" "${HEPMC_VERSION}")
  _preset_module_package(_yoda "ColliderBit" "${_collider}" "${EXCLUDE_YODA}" "${YODA_VERSION}")
  _preset_module_package(_fastjet "ColliderBit" "${_collider}" "${EXCLUDE_FASTJET}" "${FASTJET_VERSION}")
  _preset_module_package(_fjcontrib "ColliderBit" "${_collider}" "${EXCLUDE_FJCONTRIB}" "${FJCONTRIB_VERSION}")

  if(NOT _collider)
    set(_restframes "off with ColliderBit")
    set(_onnx "off with ColliderBit")
    set(_cutflow "off with ColliderBit")
    if(WITH_ONNXRUNTIME)
      set(_onnx "included, but ColliderBit is off")
    endif()
    if(CUTFLOW)
      set(_cutflow "enabled, but ColliderBit is off")
    endif()
  else()
    if(EXCLUDE_RESTFRAMES)
      if(WITH_RESTFRAMES AND EXCLUDE_ROOT)
        set(_restframes "unavailable (needs ROOT)")
      elseif(WITH_RESTFRAMES)
        set(_restframes "unavailable")
      else()
        set(_restframes "disabled")
      endif()
    else()
      _preset_included_text(_restframes "${RESTFRAMES_VERSION}")
    endif()
    if(EXCLUDE_ONNXRUNTIME)
      if(WITH_ONNXRUNTIME)
        set(_onnx "unavailable")
      else()
        set(_onnx "disabled")
      endif()
    else()
      _preset_included_text(_onnx "${ONNXRUNTIME_VERSION}")
    endif()
    if(CUTFLOW)
      set(_cutflow "enabled")
    else()
      set(_cutflow "disabled")
    endif()
  endif()

  if(NOT _spec)
    set(_flexiblesusy "off with SpecBit")
  elseif(EXCLUDE_FLEXIBLESUSY)
    set(_flexiblesusy "disabled")
  elseif("${BUILD_FS_MODELS}" STREQUAL "")
    set(_flexiblesusy "included, no models selected")
  else()
    string(REPLACE ";" ", " _fs_models "${BUILD_FS_MODELS}")
    set(_flexiblesusy "included (${_fs_models})")
  endif()

  if(NOT WITH_HDF5)
    set(_hdf5 "disabled")
  elseif(NOT HDF5_FOUND)
    set(_hdf5 "unavailable")
  else()
    _preset_included_text(_hdf5 "${HDF5_VERSION}")
  endif()
  if(NOT WITH_SQLite3)
    set(_sqlite "disabled")
  elseif(NOT SQLite3_FOUND AND NOT SQLITE3_FOUND)
    set(_sqlite "unavailable")
  elseif(SQLite3_VERSION)
    _preset_included_text(_sqlite "${SQLite3_VERSION}")
  else()
    set(_sqlite "included")
  endif()
  if(NOT WITH_MPI)
    set(_mpi "disabled")
  elseif(NOT MPI_C_FOUND AND NOT MPI_CXX_FOUND)
    set(_mpi "unavailable")
  else()
    set(_mpi "included")
  endif()
  if(EXCLUDE_ROOT)
    if(GAMBIT_ROOT_SKIP_REASON MATCHES "^disabled by")
      set(_root "disabled")
    elseif(GAMBIT_ROOT_SKIP_REASON)
      set(_root "unavailable (${GAMBIT_ROOT_SKIP_REASON})")
    elseif(WITH_ROOT)
      set(_root "unavailable")
    else()
      set(_root "disabled")
    endif()
  elseif(ROOT_VERSION)
    set(_root "included (ROOT ${ROOT_VERSION})")
  else()
    set(_root "included")
  endif()
  if(NOT HAVE_PYBIND11)
    set(_pybind "disabled")
  elseif(pybind11_VERSION)
    _preset_included_text(_pybind "pybind11 ${pybind11_VERSION}")
  else()
    set(_pybind "included")
  endif()

  # One section per physics module, in the same shape as ColliderBit.
  # Backend names come from the rollcall attribution used by interface trimming.
  # One "Bit<TAB>name" record per line, so the summary can print each name alone.
  set(_backends_by_bit "")
  set(_backend_names_ready FALSE)
  if(Python3_EXECUTABLE AND EXISTS "${PROJECT_SOURCE_DIR}/Utils/scripts/harvesting_tools.py")
    execute_process(
      COMMAND "${Python3_EXECUTABLE}" -c "
import sys
sys.path.insert(0, 'Utils/scripts')
from harvesting_tools import compute_bits_per_backend
bits_for = {}
mapping = compute_bits_per_backend('.', './Backends/include/gambit/Backends/frontends')
for backend, owners in mapping.items():
    for bit in owners:
        bits_for.setdefault(bit, []).append(backend)
for bit in sorted(bits_for):
    for name in sorted(bits_for[bit]):
        print(bit + '\t' + name)
"
      WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
      OUTPUT_VARIABLE _backends_by_bit
      ERROR_QUIET
      RESULT_VARIABLE _backends_rc
      OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(_backends_rc EQUAL 0)
      set(_backend_names_ready TRUE)
    else()
      set(_backends_by_bit "")
    endif()
  endif()
  if(NOT _backend_names_ready)
    cbs_summary_line("Backends" "names were not generated")
  endif()

  set(_module_names "")
  file(GLOB _module_dirs RELATIVE "${PROJECT_SOURCE_DIR}" "${PROJECT_SOURCE_DIR}/*Bit*")
  foreach(_dir ${_module_dirs})
    if(IS_DIRECTORY "${PROJECT_SOURCE_DIR}/${_dir}")
      string(FIND "${_dir}" ".dSYM" _dsym)
      if(_dsym EQUAL -1)
        list(APPEND _module_names "${_dir}")
      endif()
    endif()
  endforeach()
  list(SORT _module_names)

  foreach(_bit ${_module_names})
    message(STATUS "  ----------------------------------------------------------------")
    _preset_bit_enabled("${_bit}" _bit_on)
    if(_bit STREQUAL "ScannerBit")
      cbs_summary_line("${_bit}" "enabled (always built)")
    elseif(_bit_on)
      cbs_summary_line("${_bit}" "enabled")
    else()
      cbs_summary_line("${_bit}" "off")
    endif()

    if(_bit STREQUAL "ColliderBit")
      cbs_summary_line("HepMC3" "${_hepmc}")
      cbs_summary_line("YODA" "${_yoda}")
      cbs_summary_line("FastJet" "${_fastjet}")
      cbs_summary_line("FastJet Contrib" "${_fjcontrib}")
      cbs_summary_line("RestFrames" "${_restframes}")
      cbs_summary_line("ONNX Runtime" "${_onnx}")
      cbs_summary_line("Cutflow" "${_cutflow}")
      if(_groups_CBS_BACKENDS)
        set(_rivet "disabled")
        set(_contur "disabled")
        if(CBS_WITH_RIVET_CONTUR)
          if(CBS_RIVET_CONTUR_ENABLED)
            set(_rivet "included (Rivet ${Rivet_ver}; scheduled with CBS)")
            set(_contur "included (Contur ${CONTUR_VERSION}; scheduled with CBS)")
          elseif(CBS_RIVET_CONTUR_PREREQUISITES_REASON)
            set(_rivet "unavailable (${CBS_RIVET_CONTUR_PREREQUISITES_REASON})")
            set(_contur "unavailable (${CBS_RIVET_CONTUR_PREREQUISITES_REASON})")
          else()
            set(_rivet "unavailable")
            set(_contur "unavailable")
          endif()
        elseif(NOT _collider)
          set(_rivet "off with ColliderBit")
          set(_contur "off with ColliderBit")
        endif()
        cbs_summary_line("Rivet" "${_rivet}")
        cbs_summary_line("Contur" "${_contur}")
      endif()
    elseif(_bit STREQUAL "SpecBit")
      cbs_summary_line("FlexibleSUSY" "${_flexiblesusy}")
    endif()

    if(_backend_names_ready AND _bit_on AND NOT _bit STREQUAL "ScannerBit")
      set(_bit_interfaces "")
      if(NOT "${_backends_by_bit}" STREQUAL "")
        string(ASCII 9 _tab)
        string(REPLACE "\n" ";" _backend_lines "${_backends_by_bit}")
        foreach(_backend_line ${_backend_lines})
          string(FIND "${_backend_line}" "${_bit}${_tab}" _at)
          if(_at EQUAL 0)
            string(LENGTH "${_bit}${_tab}" _prefix_len)
            string(LENGTH "${_backend_line}" _line_len)
            math(EXPR _rest "${_line_len} - ${_prefix_len}")
            string(SUBSTRING "${_backend_line}" ${_prefix_len} ${_rest} _one_interface)
            if(NOT "${_one_interface}" STREQUAL "")
              # Rivet and Contur already have status rows in the CBS summary.
              if(NOT (_groups_CBS_BACKENDS AND _bit STREQUAL "ColliderBit"
                      AND (_one_interface STREQUAL "Rivet" OR _one_interface STREQUAL "Contur")))
                list(APPEND _bit_interfaces "${_one_interface}")
              endif()
            endif()
          endif()
        endforeach()
      endif()
      if(_bit_interfaces)
        list(LENGTH _bit_interfaces _interface_count)
        cbs_summary_line("Backends" "${_interface_count}")
        foreach(_interface ${_bit_interfaces})
          message(STATUS "    ${_interface}")
        endforeach()
      else()
        cbs_summary_line("Backends" "none")
      endif()
    endif()
  endforeach()

  message(STATUS "  ----------------------------------------------------------------")
  message(STATUS "  Common")
  cbs_summary_line("HDF5" "${_hdf5}")
  cbs_summary_line("SQLite3" "${_sqlite}")
  cbs_summary_line("MPI" "${_mpi}")
  cbs_summary_line("ROOT" "${_root}")
  cbs_summary_line("Python bindings" "${_pybind}")
endfunction()
