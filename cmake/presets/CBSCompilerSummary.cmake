#
# Final build summary for configurations selected through a CBS preset.

include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../CompilerCache.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CBSCompilerDiscovery.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/CBSValidation.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PresetFeatureSummary.cmake")

function(cbs_print_compiler_summary)
  if(NOT CBS_PRESET_BUILD)
    return()
  endif()

  cbs_compiler_is_supported("${CMAKE_CXX_COMPILER_ID}" "${CMAKE_CXX_COMPILER_VERSION}" _cbs_supported _cbs_reason)

  set(_cbs_bits_text "ColliderBit (+ ScannerBit)")
  if(GAMBIT_BITS)
    set(_cbs_bits_text "${GAMBIT_BITS}")
    string(REPLACE ";" ", " _cbs_bits_text "${_cbs_bits_text}")
  endif()
  set(_cbs_interface_count "not trimmed")
  if(GAMBIT_TRIM_BACKEND_INTERFACES_EFFECTIVE AND GAMBIT_TRIM_TOTAL_COUNT)
    set(_cbs_interface_count
        "${GAMBIT_TRIM_USED_COUNT} of ${GAMBIT_TRIM_TOTAL_COUNT} kept")
  endif()

  message(STATUS "")
  message(STATUS "================================================================")
  message(STATUS "                         CBS build summary")
  message(STATUS "----------------------------------------------------------------")
  cbs_summary_line("Preset" "${CBS_BUILD_PRESET}")
  if(GAMBIT_RESOLVED_TOOLCHAIN STREQUAL "llvm")
    cbs_summary_line("Toolchain" "upstream LLVM ${GAMBIT_RESOLVED_LLVM_VERSION}")
    cbs_summary_line("LLVM root" "${GAMBIT_RESOLVED_LLVM_ROOT}")
  elseif(GAMBIT_RESOLVED_TOOLCHAIN STREQUAL "macos")
    cbs_summary_line("Toolchain" "macOS AppleClang")
  elseif(GAMBIT_RESOLVED_TOOLCHAIN STREQUAL "gnu")
    cbs_summary_line("Toolchain" "Linux GNU")
  elseif("${CBS_BUILD_PRESET}" STREQUAL "cbs-llvm")
    cbs_summary_line("Toolchain" "upstream LLVM ${CBS_RESOLVED_LLVM_VERSION}")
    cbs_summary_line("LLVM root" "${CBS_RESOLVED_LLVM_ROOT}")
  else()
    cbs_summary_line("Toolchain" "system environment")
  endif()
  cbs_summary_line("C" "${CMAKE_C_COMPILER_ID} ${CMAKE_C_COMPILER_VERSION}  (${CMAKE_C_COMPILER})")
  cbs_summary_line("C++" "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}  (${CMAKE_CXX_COMPILER})")
  cbs_summary_line("C++ standard" "${GAMBIT_CXX_STANDARD} (${GAMBIT_CXX_STANDARD_REASON}; requested ${GAMBIT_CXX_STANDARD_REQUESTED})")
  gambit_print_compiler_cache_summary()
  cbs_summary_line("Fortran" "${CMAKE_Fortran_COMPILER_ID} ${CMAKE_Fortran_COMPILER_VERSION}  (${CMAKE_Fortran_COMPILER})")
  if(Python3_Interpreter_FOUND)
    cbs_summary_line("Python" "CPython ${Python3_VERSION}  (${Python3_EXECUTABLE})")
  endif()
  if(OPENMP_FOUND OR FOUND_BREW_OPENMP OR GAMBIT_MACOS_HOMEBREW_LLVM_OPENMP)
    cbs_summary_line("OpenMP" "enabled")
  else()
    cbs_summary_line("OpenMP" "unavailable")
  endif()
  cbs_summary_line("Bits" "${_cbs_bits_text}")
  cbs_summary_line("Backend trim" "${GAMBIT_TRIM_BACKEND_INTERFACES_REQUESTED} -> ${GAMBIT_TRIM_BACKEND_INTERFACES_EFFECTIVE}")
  cbs_summary_line("Backends" "${_cbs_interface_count}")
  message(STATUS "  ----------------------------------------------------------------")
  cbs_print_validation_summary()

  preset_print_feature_groups(CBS_BACKENDS)
  cbs_summary_line("Build tree" "${CMAKE_BINARY_DIR}")
  if(_cbs_supported)
    cbs_summary_line("Compatibility" "supported")
  else()
    cbs_summary_line("Compatibility" "unsupported (${_cbs_reason})")
  endif()
  message(STATUS "================================================================")
endfunction()
