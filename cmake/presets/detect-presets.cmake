# Generic, read-only dispatcher for systems registered in CMakePresets.json.
# Run through cmake/bootstrap; configure/build remain native CMake operations.

cmake_minimum_required(VERSION 3.24)

get_filename_component(_bootstrap_source_dir "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(READ "${_bootstrap_source_dir}/CMakePresets.json" _bootstrap_registry)
string(JSON _bootstrap_count LENGTH "${_bootstrap_registry}" configurePresets)
set(_bootstrap_names "")
set(_bootstrap_systems "")
if(_bootstrap_count GREATER 0)
  math(EXPR _bootstrap_last "${_bootstrap_count} - 1")
  foreach(_bootstrap_index RANGE ${_bootstrap_last})
    string(JSON _bootstrap_hidden ERROR_VARIABLE _bootstrap_error
           GET "${_bootstrap_registry}" configurePresets ${_bootstrap_index} hidden)
    if(_bootstrap_hidden AND NOT _bootstrap_error)
      continue()
    endif()
    string(JSON _bootstrap_metadata ERROR_VARIABLE _bootstrap_error
           GET "${_bootstrap_registry}" configurePresets ${_bootstrap_index} vendor "gambit/bootstrap/1")
    if(_bootstrap_error)
      continue()
    endif()
    string(JSON _bootstrap_name GET "${_bootstrap_registry}" configurePresets ${_bootstrap_index} name)
    string(JSON _bootstrap_system GET "${_bootstrap_metadata}" system)
    string(JSON _bootstrap_strategy GET "${_bootstrap_metadata}" toolchain)
    if(NOT _bootstrap_name MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$" OR
       NOT _bootstrap_system MATCHES "^[a-z][a-z0-9_]*$" OR
       NOT _bootstrap_strategy MATCHES "^(macos|gnu|llvm)$")
      message(FATAL_ERROR "Invalid bootstrap metadata for preset '${_bootstrap_name}'")
    endif()
    if(_bootstrap_name IN_LIST _bootstrap_names)
      message(FATAL_ERROR "Duplicate bootstrap preset '${_bootstrap_name}'")
    endif()
    string(JSON _bootstrap_display ERROR_VARIABLE _bootstrap_error
           GET "${_bootstrap_registry}" configurePresets ${_bootstrap_index} displayName)
    if(_bootstrap_error)
      set(_bootstrap_display "${_bootstrap_name}")
    endif()
    list(APPEND _bootstrap_names "${_bootstrap_name}")
    list(APPEND _bootstrap_systems "${_bootstrap_system}")
    set(_bootstrap_${_bootstrap_name}_system "${_bootstrap_system}")
    set(_bootstrap_${_bootstrap_name}_strategy "${_bootstrap_strategy}")
    set(_bootstrap_${_bootstrap_name}_display "${_bootstrap_display}")
  endforeach()
endif()
list(REMOVE_DUPLICATES _bootstrap_systems)
if(NOT _bootstrap_names)
  message(FATAL_ERROR "No public presets are registered with vendor 'gambit/bootstrap/1'")
endif()

# Reject bad filters before loading providers or running environment commands.
foreach(_bootstrap_system IN LISTS BOOTSTRAP_SYSTEMS)
  if(NOT _bootstrap_system IN_LIST _bootstrap_systems)
    message(FATAL_ERROR "Unknown system '${_bootstrap_system}'. Registered systems: ${_bootstrap_systems}")
  endif()
endforeach()
foreach(_bootstrap_name IN LISTS BOOTSTRAP_PRESETS)
  if(NOT _bootstrap_name IN_LIST _bootstrap_names)
    message(FATAL_ERROR "Unknown preset '${_bootstrap_name}'. Registered presets: ${_bootstrap_names}")
  endif()
endforeach()

set(_bootstrap_selected "")
set(_bootstrap_selected_systems "")
set(_bootstrap_report_systems "")
include("${CMAKE_CURRENT_LIST_DIR}/NativeCompilerDiscovery.cmake")
foreach(_bootstrap_name IN LISTS _bootstrap_names)
  set(_bootstrap_system "${_bootstrap_${_bootstrap_name}_system}")
  if(BOOTSTRAP_SYSTEMS AND NOT _bootstrap_system IN_LIST BOOTSTRAP_SYSTEMS)
    continue()
  endif()
  if(BOOTSTRAP_PRESETS AND NOT _bootstrap_name IN_LIST BOOTSTRAP_PRESETS)
    continue()
  endif()
  list(APPEND _bootstrap_selected "${_bootstrap_name}")
  list(APPEND _bootstrap_report_systems "${_bootstrap_system}")
  native_toolchain_host_supported("${_bootstrap_${_bootstrap_name}_strategy}"
    _bootstrap_host_supported _bootstrap_host_reason)
  set(_bootstrap_${_bootstrap_name}_host_reason "${_bootstrap_host_reason}")
  if(_bootstrap_host_supported)
    list(APPEND _bootstrap_selected_systems "${_bootstrap_system}")
  endif()
endforeach()
if(NOT _bootstrap_selected)
  message(FATAL_ERROR "No presets match both --system and --preset filters. Run ./cmake/bootstrap --list.")
endif()
list(REMOVE_DUPLICATES _bootstrap_selected_systems)
list(REMOVE_DUPLICATES _bootstrap_report_systems)
list(LENGTH _bootstrap_selected _bootstrap_selected_count)
include("${CMAKE_CURRENT_LIST_DIR}/BootstrapReport.cmake")
bootstrap_report_header("${_bootstrap_report_systems}" "${_bootstrap_selected_count}")

if(BOOTSTRAP_LIST_ONLY)
  bootstrap_report_section("Registered presets")
  foreach(_bootstrap_name IN LISTS _bootstrap_selected)
    bootstrap_report_preset("${_bootstrap_name}" "${_bootstrap_${_bootstrap_name}_strategy}"
      "${_bootstrap_${_bootstrap_name}_display}" "${_bootstrap_${_bootstrap_name}_host_reason}" TRUE)
  endforeach()
  bootstrap_report_finish(0 0 0 TRUE)
  return()
endif()

# Load only the requested systems. A new system adds one provider module and
# public-preset metadata, without modifying this dispatcher or the shell CLI.
foreach(_bootstrap_system IN LISTS _bootstrap_selected_systems)
  string(TOUPPER "${_bootstrap_system}" _bootstrap_provider_name)
  set(_bootstrap_provider "${CMAKE_CURRENT_LIST_DIR}/${_bootstrap_provider_name}Availability.cmake")
  if(NOT EXISTS "${_bootstrap_provider}")
    message(FATAL_ERROR "No bootstrap provider for system '${_bootstrap_system}': ${_bootstrap_provider}")
  endif()
  include("${_bootstrap_provider}")
  if(NOT COMMAND preset_probe_${_bootstrap_system})
    message(FATAL_ERROR "Provider ${_bootstrap_provider} must define preset_probe_${_bootstrap_system}")
  endif()
endforeach()

if(_bootstrap_selected_systems)
  include("${CMAKE_CURRENT_LIST_DIR}/PresetEnvironmentDiscovery.cmake")
  set(ENV{PYTHONDONTWRITEBYTECODE} 1)
  preset_probe_collect_environment()
endif()
foreach(_bootstrap_system IN LISTS _bootstrap_selected_systems)
  if(COMMAND preset_probe_prepare_${_bootstrap_system})
    cmake_language(CALL preset_probe_prepare_${_bootstrap_system})
  endif()
endforeach()

set(_bootstrap_available "")
set(_bootstrap_unavailable_count 0)
set(_bootstrap_other_host_count 0)
bootstrap_report_section("Presets")
foreach(_bootstrap_name IN LISTS _bootstrap_selected)
  set(_bootstrap_system "${_bootstrap_${_bootstrap_name}_system}")
  if(_bootstrap_${_bootstrap_name}_host_reason)
    bootstrap_report_preset("${_bootstrap_name}" "${_bootstrap_${_bootstrap_name}_strategy}"
      "${_bootstrap_${_bootstrap_name}_display}" "${_bootstrap_${_bootstrap_name}_host_reason}" FALSE)
    math(EXPR _bootstrap_other_host_count "${_bootstrap_other_host_count} + 1")
    continue()
  endif()
  cmake_language(CALL preset_probe_${_bootstrap_system} "${_bootstrap_name}"
    "${_bootstrap_${_bootstrap_name}_strategy}" "${_bootstrap_${_bootstrap_name}_display}"
    _bootstrap_preset_available)
  set_property(GLOBAL PROPERTY BOOTSTRAP_${_bootstrap_name}_AVAILABLE "${_bootstrap_preset_available}")
  if(_bootstrap_preset_available)
    list(APPEND _bootstrap_available "${_bootstrap_name}")
  else()
    math(EXPR _bootstrap_unavailable_count "${_bootstrap_unavailable_count} + 1")
  endif()
  bootstrap_report_preset("${_bootstrap_name}" "${_bootstrap_${_bootstrap_name}_strategy}"
    "${_bootstrap_${_bootstrap_name}_display}" "" FALSE)
endforeach()

if(_bootstrap_selected_systems)
  bootstrap_report_environment()
  foreach(_bootstrap_system IN LISTS _bootstrap_selected_systems)
    if(COMMAND preset_probe_report_${_bootstrap_system})
      cmake_language(CALL preset_probe_report_${_bootstrap_system})
    endif()
  endforeach()
endif()
if(_bootstrap_available)
  bootstrap_report_commands("${_bootstrap_available}" "${_bootstrap_source_dir}")
else()
  bootstrap_report_line("  No selected preset is available. Review the reasons above.")
  bootstrap_report_line("")
endif()
list(LENGTH _bootstrap_available _bootstrap_available_count)
bootstrap_report_finish("${_bootstrap_available_count}" "${_bootstrap_unavailable_count}"
  "${_bootstrap_other_host_count}" FALSE)
