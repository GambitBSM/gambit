# Shared dependency choices for public GAMBIT and standalone presets.
# Defaults fill an empty cache; changing the preset must not reset choices.
include_guard(GLOBAL)
set(_GAMBIT_PRESET_DEPENDENCIES_DIR "${CMAKE_CURRENT_LIST_DIR}")

macro(_gambit_preset_auto_option name legacy description)
  # Import the old CBS spelling once. The public spelling takes precedence;
  # remove the obsolete entry so it cannot shadow later shared choices.
  if(DEFINED ${legacy})
    set(_preset_legacy_value "${${legacy}}")
    if(NOT DEFINED ${name})
      set(${name} "${_preset_legacy_value}" CACHE BOOL "${description}")
    endif()
    unset(${legacy} CACHE)
    unset(${legacy})
    unset(_preset_legacy_value)
  endif()
  option(${name} "${description}" ON)
endmacro()

macro(gambit_initialise_preset_dependencies)
  # The marker also covers local presets using their own compiler/toolchain.
  set(_GAMBIT_PRESET_DEPENDENCIES_ACTIVE FALSE)
  if(GAMBIT_PRESET_DEPENDENCIES OR GAMBIT_PRESET_TOOLCHAIN OR CBS_BUILD_PRESET)
    set(_GAMBIT_PRESET_DEPENDENCIES_ACTIVE TRUE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Choose the build type")
    set(_preset_cbs_defaults OFF)
    if(CBS_BUILD_PRESET)
      set(_preset_cbs_defaults ON)
    endif()
    option(WITH_MPI "Compile with MPI enabled" OFF)
    option(WITH_HDF5 "Compile with HDF5 enabled" ON)
    option(WITH_SQLite3 "Compile with SQLite3 enabled" ON)
    option(WITH_RESTFRAMES "Compile with RestFrames enabled" ${_preset_cbs_defaults})
    option(WITH_ONNXRUNTIME "Compile with ONNX Runtime enabled" ${_preset_cbs_defaults})
    option(CUTFLOW "Enable cut-flow output" ${_preset_cbs_defaults})
    option(CBS_WITH_RIVET_CONTUR "CBS: enable Rivet/Contur when available" ${_preset_cbs_defaults})
    _gambit_preset_auto_option(GAMBIT_AUTO_DETECT_PYTHON CBS_AUTO_DETECT_PYTHON
        "Presets: select python3 on PATH before FindPython3")
    _gambit_preset_auto_option(GAMBIT_AUTO_DETECT_ROOT CBS_AUTO_DETECT_ROOT
        "Presets: discover a supported ROOT installation")
    # Keep AUTO as the cache request. The effective ON/OFF value lives only in
    # this configure, so missing ROOT today cannot disable discovery tomorrow.
    if(NOT DEFINED WITH_ROOT)
      set(WITH_ROOT AUTO)
    endif()
    set(WITH_ROOT "${WITH_ROOT}" CACHE STRING "ROOT support: AUTO, ON or OFF" FORCE)
    set_property(CACHE WITH_ROOT PROPERTY STRINGS AUTO ON OFF)
    unset(_preset_cbs_defaults)
  endif()
endmacro()

macro(gambit_preset_discover_python)
  if(_GAMBIT_PRESET_DEPENDENCIES_ACTIVE AND GAMBIT_AUTO_DETECT_PYTHON)
    include("${_GAMBIT_PRESET_DEPENDENCIES_DIR}/CBSPythonDiscovery.cmake")
    if(CBS_PRESET_BUILD)
      preset_pin_python3_on_path("CBS")
    else()
      preset_pin_python3_on_path("GAMBIT")
    endif()
  endif()
endmacro()

macro(gambit_preset_discover_root)
  if(_GAMBIT_PRESET_DEPENDENCIES_ACTIVE)
    include("${_GAMBIT_PRESET_DEPENDENCIES_DIR}/CBSRootDiscovery.cmake")
    set(GAMBIT_ROOT_SKIP_REASON "")
    set(GAMBIT_RESOLVED_ROOT "")
    set(GAMBIT_RESOLVED_ROOT_VERSION "")
    string(TOUPPER "${WITH_ROOT}" _preset_root_request)
    if(NOT _preset_root_request STREQUAL "AUTO" AND
        NOT _preset_root_request MATCHES "^(ON|OFF|TRUE|FALSE|YES|NO|Y|N|1|0|IGNORE|NOTFOUND|)$" AND
        NOT _preset_root_request MATCHES "-NOTFOUND$")
      message(FATAL_ERROR "Invalid WITH_ROOT='${WITH_ROOT}'. Choose AUTO, ON or OFF.")
    endif()
    if(CBS_PRESET_BUILD)
      set(_preset_root_label CBS)
    else()
      set(_preset_root_label GAMBIT)
    endif()
    if(NOT WITH_ROOT)
      set(GAMBIT_ROOT_SKIP_REASON "disabled by WITH_ROOT=OFF")
    elseif(NOT GAMBIT_AUTO_DETECT_ROOT)
      if(_preset_root_request STREQUAL "AUTO")
        set(WITH_ROOT OFF)
        set(GAMBIT_ROOT_SKIP_REASON "disabled by GAMBIT_AUTO_DETECT_ROOT=OFF")
      endif()
    else()
      cbs_find_root_installation(_preset_root_found _preset_root_prefix
          _preset_root_version _preset_root_reason)
      if(_preset_root_found)
        set(GAMBIT_ROOT_PREFIX "${_preset_root_prefix}" CACHE PATH
            "ROOT installation shared by public presets" FORCE)
        set(ENV{ROOTSYS} "${_preset_root_prefix}")
        set(WITH_ROOT ON)
        set(GAMBIT_RESOLVED_ROOT "${_preset_root_prefix}")
        set(GAMBIT_RESOLVED_ROOT_VERSION "${_preset_root_version}")
        message(STATUS "${_preset_root_label} ROOT: ${_preset_root_version} from ${_preset_root_prefix}")
      else()
        set(GAMBIT_ROOT_SKIP_REASON "${_preset_root_reason}")
        if(_preset_root_request STREQUAL "AUTO")
          set(WITH_ROOT OFF)
          message(STATUS "${_preset_root_label} ROOT: ${_preset_root_reason}; ROOT-dependent features remain disabled")
        endif()
        # Explicit ON still goes through GAMBIT's native FindROOT path, which
        # also supports installations selected with CMake package hints.
      endif()
    endif()
    unset(_preset_root_request)
    unset(_preset_root_label)
    unset(_preset_root_found)
    unset(_preset_root_prefix)
    unset(_preset_root_version)
    unset(_preset_root_reason)
  endif()
endmacro()
