# Native compiler strategies shared by all registered systems and bootstrap.
# Reuse GAMBIT's existing compiler support policy and upstream LLVM discovery.

include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/CBSCompilerDiscovery.cmake")

function(native_toolchain_host_supported strategy output_supported output_reason)
  set(_native_supported FALSE)
  if(strategy STREQUAL "macos")
    set(_native_hosts Darwin)
  elseif(strategy STREQUAL "gnu")
    set(_native_hosts Linux)
  elseif(strategy STREQUAL "llvm")
    set(_native_hosts Darwin Linux)
  else()
    message(FATAL_ERROR "Unknown native compiler strategy: ${strategy}")
  endif()
  if(CMAKE_HOST_SYSTEM_NAME IN_LIST _native_hosts)
    set(_native_supported TRUE)
    set(_native_reason "")
  else()
    string(JOIN " or " _native_host_text ${_native_hosts})
    set(_native_reason "${strategy} requires ${_native_host_text}; this host is ${CMAKE_HOST_SYSTEM_NAME}")
  endif()
  set(${output_supported} "${_native_supported}" PARENT_SCOPE)
  set(${output_reason} "${_native_reason}" PARENT_SCOPE)
endfunction()

function(native_find_toolchain strategy output_found output_c output_cxx output_fortran output_root output_version output_reason)
  native_toolchain_host_supported("${strategy}" _native_host_supported _native_reason)
  set(_native_c "")
  set(_native_cxx "")
  set(_native_fortran "")
  set(_native_root "")
  set(_native_version "")
  set(_native_found FALSE)
  if(_native_host_supported)
    if(strategy STREQUAL "llvm")
      cbs_find_llvm_toolchain(_native_found _native_c _native_cxx _native_version
                             _native_origin _native_reason)
      if(_native_found)
        get_filename_component(_native_root "${_native_origin}" DIRECTORY)
      endif()
    else()
      # Explicit compiler selections must match the family of this profile.
      foreach(_native_language C CXX)
        if(_native_language STREQUAL "C")
          set(_native_environment CC)
          set(_native_command gcc)
          set(_native_apple_command clang)
        else()
          set(_native_environment CXX)
          set(_native_command g++)
          set(_native_apple_command clang++)
        endif()
        set(_native_compiler "")
        if(DEFINED CMAKE_${_native_language}_COMPILER AND
           NOT "${CMAKE_${_native_language}_COMPILER}" STREQUAL "")
          cbs_resolve_command(_native_compiler "${CMAKE_${_native_language}_COMPILER}")
        elseif(NOT "$ENV{${_native_environment}}" STREQUAL "")
          cbs_resolve_command(_native_compiler "$ENV{${_native_environment}}")
        elseif(strategy STREQUAL "macos")
          cbs_resolve_command(_native_xcrun xcrun)
          if(_native_xcrun)
            gambit_process_probe(COMMAND "${_native_xcrun}" --find "${_native_apple_command}"
              RESULT_VARIABLE _native_xcrun_result
              OUTPUT_VARIABLE _native_compiler
              OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET TIMEOUT 10)
            if(NOT _native_xcrun_result EQUAL 0)
              set(_native_compiler "")
            endif()
          endif()
          if(NOT _native_compiler)
            cbs_resolve_command(_native_compiler "/usr/bin/${_native_apple_command}")
          endif()
        else()
          cbs_resolve_command(_native_compiler "${_native_command}")
        endif()
        set(_native_${_native_language} "${_native_compiler}")
      endforeach()
      set(_native_c "${_native_C}")
      set(_native_cxx "${_native_CXX}")
      cbs_validate_c_cxx_pair("${_native_c}" "${_native_cxx}" _native_found
                             _native_id _native_version _native_reason)
      if(strategy STREQUAL "macos")
        set(_native_required_id AppleClang)
      else()
        set(_native_required_id GNU)
      endif()
      if(_native_found AND NOT _native_id STREQUAL _native_required_id)
        set(_native_found FALSE)
        set(_native_reason "${strategy} requires ${_native_required_id} C/C++, but selected ${_native_id}; check CC/CXX or use --fresh to clear cached compilers")
      endif()
    endif()
    cbs_find_fortran_compiler(_native_fortran _native_fortran_id
                             _native_fortran_version _native_fortran_reason)
    if(_native_fortran_reason)
      set(_native_found FALSE)
      list(APPEND _native_reason "${_native_fortran_reason}")
    elseif(strategy STREQUAL "gnu" AND NOT _native_fortran_id STREQUAL "GNU")
      set(_native_found FALSE)
      list(APPEND _native_reason "Linux GNU requires GNU Fortran; check FC")
    endif()
  endif()
  set(${output_found} "${_native_found}" PARENT_SCOPE)
  set(${output_c} "${_native_c}" PARENT_SCOPE)
  set(${output_cxx} "${_native_cxx}" PARENT_SCOPE)
  set(${output_fortran} "${_native_fortran}" PARENT_SCOPE)
  set(${output_root} "${_native_root}" PARENT_SCOPE)
  set(${output_version} "${_native_version}" PARENT_SCOPE)
  set(${output_reason} "${_native_reason}" PARENT_SCOPE)
endfunction()
