+  V2[4] = denom * (OM2 * P2[2] * (+cI * (TMP21 * TMP35 + TMP23 * TMP39 + TMP6 *
+      TMP41)) + (-cI * (V3[4] * TMP35 + TMP23 * V4[4] + V1[4] * TMP41)));
+  V2[5] = denom * (OM2 * P2[3] * (+cI * (TMP21 * TMP35 + TMP23 * TMP39 + TMP6 *
+      TMP41)) + (-cI * (V3[5] * TMP35 + TMP23 * V4[5] + V1[5] * TMP41)));
+}
