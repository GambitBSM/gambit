+  P1[1] = V1[1].real(); 
+  P1[2] = V1[1].imag(); 
+  P1[3] = V1[0].imag(); 
+  TMP14 = (P1[0] * V3[2] - P1[1] * V3[3] - P1[2] * V3[4] - P1[3] * V3[5]); 
+  TMP12 = (V1[2] * V2[2] - V1[3] * V2[3] - V1[4] * V2[4] - V1[5] * V2[5]); 
+  vertex = COUP * - cI * TMP14 * TMP12; 
+}
