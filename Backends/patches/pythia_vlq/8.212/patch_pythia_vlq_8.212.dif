+  TMP43 = (V3[2] * P4[0] - V3[3] * P4[1] - V3[4] * P4[2] - V3[5] * P4[3]); 
+  denom = COUP/((P4[0] * P4[0]) - (P4[1] * P4[1]) - (P4[2] * P4[2]) - (P4[3] *
+      P4[3]) - M4 * (M4 - cI * W4));
+  V4[2] = denom * TMP9 * (-cI * (V3[2]) + cI * (P4[0] * OM4 * TMP43)); 
+  V4[3] = denom * TMP9 * (-cI * (V3[3]) + cI * (P4[1] * OM4 * TMP43)); 
+  V4[4] = denom * TMP9 * (-cI * (V3[4]) + cI * (P4[2] * OM4 * TMP43)); 
+  V4[5] = denom * TMP9 * (-cI * (V3[5]) + cI * (P4[3] * OM4 * TMP43)); 
+}
