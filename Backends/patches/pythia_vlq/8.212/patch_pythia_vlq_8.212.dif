+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * (OM3 * P3[0] * (+cI * (TMP24 * TMP35) - cI * (TMP26 * TMP38))
+      + (-cI * (V2[2] * TMP35) + cI * (V1[2] * TMP38)));
