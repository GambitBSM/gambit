+// Routines for printing out parameters
+void Parameters_VLQ::printIndependentParameters()
+{
+  cout <<  "VLQ model parameters independent of event kinematics:" << endl; 
+  cout << setw(20) <<  "mdl_WY " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_WY << endl;
+  cout << setw(20) <<  "mdl_WBP " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_WBP << endl;
