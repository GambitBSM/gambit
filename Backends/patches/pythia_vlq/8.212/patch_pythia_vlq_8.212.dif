+
+void VVVV10_0(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> V3[], std::complex<double> V4[], std::complex<double>
+    COUP, std::complex<double> & vertex)
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  std::complex<double> TMP23; 
+  std::complex<double> TMP25; 
+  std::complex<double> TMP35; 
+  std::complex<double> TMP38; 
+  std::complex<double> TMP41; 
+  std::complex<double> TMP9; 
+  TMP35 = (V1[2] * V4[2] - V1[3] * V4[3] - V1[4] * V4[4] - V1[5] * V4[5]); 
+  TMP9 = (V2[2] * V1[2] - V2[3] * V1[3] - V2[4] * V1[4] - V2[5] * V1[5]); 
+  TMP38 = (V2[2] * V4[2] - V2[3] * V4[3] - V2[4] * V4[4] - V2[5] * V4[5]); 
+  TMP23 = (V1[2] * V3[2] - V1[3] * V3[3] - V1[4] * V3[4] - V1[5] * V3[5]); 
+  TMP25 = (V2[2] * V3[2] - V2[3] * V3[3] - V2[4] * V3[4] - V2[5] * V3[5]); 
+  TMP41 = (V3[2] * V4[2] - V3[3] * V4[3] - V3[4] * V4[4] - V3[5] * V4[5]); 
+  vertex = COUP * (-1.) * (+cI * (TMP25 * TMP35 + TMP23 * TMP38 + TMP9 *
+      TMP41));
+}
