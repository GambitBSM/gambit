+  TMP39 = (P2[0] * V4[2] - P2[1] * V4[3] - P2[2] * V4[4] - P2[3] * V4[5]); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  V2[2] = denom * (OM2 * P2[0] * (+cI * (TMP21 * TMP35) - cI * (TMP23 * TMP39))
+      + (-cI * (V3[2] * TMP35) + cI * (TMP23 * V4[2])));
+  V2[3] = denom * (OM2 * P2[1] * (+cI * (TMP21 * TMP35) - cI * (TMP23 * TMP39))
+      + (-cI * (V3[3] * TMP35) + cI * (TMP23 * V4[3])));
+  V2[4] = denom * (OM2 * P2[2] * (+cI * (TMP21 * TMP35) - cI * (TMP23 * TMP39))
+      + (-cI * (V3[4] * TMP35) + cI * (TMP23 * V4[4])));
+  V2[5] = denom * (OM2 * P2[3] * (+cI * (TMP21 * TMP35) - cI * (TMP23 * TMP39))
+      + (-cI * (V3[5] * TMP35) + cI * (TMP23 * V4[5])));
