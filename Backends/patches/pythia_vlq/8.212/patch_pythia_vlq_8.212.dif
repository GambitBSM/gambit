+  pars->setDependentParameters(particleDataPtr, couplingsPtr, slhaPtr, alpS); 
+  pars->setDependentCouplings(); 
+  // Reset color flows
+  for(int i = 0; i < 2; i++ )
+    jamp2[0][i] = 0.; 
+
