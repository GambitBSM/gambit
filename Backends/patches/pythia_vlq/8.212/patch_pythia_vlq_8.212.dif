+void VVVV1_4(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> V3[], std::complex<double> COUP, double M4, double W4,
+    std::complex<double> V4[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM4; 
+  double P4[4]; 
+  std::complex<double> TMP19; 
+  std::complex<double> TMP22; 
+  std::complex<double> denom; 
+  OM4 = 0.; 
+  if (M4 != 0.)
+    OM4 = 1./(M4 * M4); 
+  V4[0] = +V1[0] + V2[0] + V3[0]; 
+  V4[1] = +V1[1] + V2[1] + V3[1]; 
+  P4[0] = -V4[0].real(); 
+  P4[1] = -V4[1].real(); 
+  P4[2] = -V4[1].imag(); 
+  P4[3] = -V4[0].imag(); 
+  TMP22 = (V1[2] * P4[0] - V1[3] * P4[1] - V1[4] * P4[2] - V1[5] * P4[3]); 
+  TMP19 = (V3[2] * V2[2] - V3[3] * V2[3] - V3[4] * V2[4] - V3[5] * V2[5]); 
+  denom = COUP/((P4[0] * P4[0]) - (P4[1] * P4[1]) - (P4[2] * P4[2]) - (P4[3] *
+      P4[3]) - M4 * (M4 - cI * W4));
+  V4[2] = denom * TMP19 * (-cI * (V1[2]) + cI * (P4[0] * OM4 * TMP22)); 
+  V4[3] = denom * TMP19 * (-cI * (V1[3]) + cI * (P4[1] * OM4 * TMP22)); 
+  V4[4] = denom * TMP19 * (-cI * (V1[4]) + cI * (P4[2] * OM4 * TMP22)); 
+  V4[5] = denom * TMP19 * (-cI * (V1[5]) + cI * (P4[3] * OM4 * TMP22)); 
