+
+void VVVV10_1(std::complex<double> V2[], std::complex<double> V3[],
+    std::complex<double> V4[], std::complex<double> COUP, double M1, double W1,
+    std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM1; 
+  double P1[4]; 
+  std::complex<double> TMP10; 
+  std::complex<double> TMP20; 
+  std::complex<double> TMP25; 
+  std::complex<double> TMP36; 
+  std::complex<double> TMP38; 
+  std::complex<double> TMP41; 
+  std::complex<double> denom; 
+  OM1 = 0.; 
+  if (M1 != 0.)
+    OM1 = 1./(M1 * M1); 
+  V1[0] = +V2[0] + V3[0] + V4[0]; 
+  V1[1] = +V2[1] + V3[1] + V4[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  TMP10 = (P1[0] * V2[2] - P1[1] * V2[3] - P1[2] * V2[4] - P1[3] * V2[5]); 
+  TMP38 = (V2[2] * V4[2] - V2[3] * V4[3] - V2[4] * V4[4] - V2[5] * V4[5]); 
+  TMP20 = (P1[0] * V3[2] - P1[1] * V3[3] - P1[2] * V3[4] - P1[3] * V3[5]); 
+  TMP25 = (V2[2] * V3[2] - V2[3] * V3[3] - V2[4] * V3[4] - V2[5] * V3[5]); 
+  TMP41 = (V3[2] * V4[2] - V3[3] * V4[3] - V3[4] * V4[4] - V3[5] * V4[5]); 
+  TMP36 = (P1[0] * V4[2] - P1[1] * V4[3] - P1[2] * V4[4] - P1[3] * V4[5]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * (OM1 * P1[0] * (+cI * (TMP25 * TMP36 + TMP20 * TMP38 + TMP10
+      * TMP41)) + (-cI * (TMP25 * V4[2] + V3[2] * TMP38 + V2[2] * TMP41)));
+  V1[3] = denom * (OM1 * P1[1] * (+cI * (TMP25 * TMP36 + TMP20 * TMP38 + TMP10
+      * TMP41)) + (-cI * (TMP25 * V4[3] + V3[3] * TMP38 + V2[3] * TMP41)));
+  V1[4] = denom * (OM1 * P1[2] * (+cI * (TMP25 * TMP36 + TMP20 * TMP38 + TMP10
+      * TMP41)) + (-cI * (TMP25 * V4[4] + V3[4] * TMP38 + V2[4] * TMP41)));
+  V1[5] = denom * (OM1 * P1[3] * (+cI * (TMP25 * TMP36 + TMP20 * TMP38 + TMP10
+      * TMP41)) + (-cI * (TMP25 * V4[5] + V3[5] * TMP38 + V2[5] * TMP41)));
+}
