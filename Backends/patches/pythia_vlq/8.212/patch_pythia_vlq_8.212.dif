+      setw(10) << mdl_WH << endl;
+  cout << setw(20) <<  "mdl_WT " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_WT << endl;
+  cout << setw(20) <<  "mdl_WW " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_WW << endl;
+  cout << setw(20) <<  "mdl_WZ " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_WZ << endl;
+  cout << setw(20) <<  "mdl_MY " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_MY << endl;
+  cout << setw(20) <<  "mdl_MBP " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_MBP << endl;
+  cout << setw(20) <<  "mdl_MTP " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_MTP << endl;
+  cout << setw(20) <<  "mdl_MX " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << mdl_MX << endl;
