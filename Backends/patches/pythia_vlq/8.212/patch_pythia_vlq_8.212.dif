+      P2[3]) - M2 * (M2 - cI * W2));
+  V2[2] = denom * (OM2 * P2[0] * (TMP23 * (-cI * (TMP7) + cI * (TMP28)) + (+cI
+      * (TMP6 * TMP20) - cI * (TMP21 * TMP26))) + (TMP23 * (+cI * (P1[0]) - cI
+      * (P3[0])) + (V1[2] * (-cI * (TMP20) + cI * (TMP21)) + V3[2] * (-cI *
+      (TMP6) + cI * (TMP26)))));
