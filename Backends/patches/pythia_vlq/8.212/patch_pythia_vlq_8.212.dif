+++ /home/tomas/Documents/Gambit/gambit_SMEFT/gum/Outputs/VLQ/MadGraph5_aMC/Pythia_patched/examples/main_VLQ_1.cc	2024-06-04 09:55:20.011841048 +0200
@@ -0,0 +1,108 @@
+//==========================================================================
+// This file has been automatically generated for Pythia 8 by
+// MadGraph5_aMC@NLO v. 2.8.3.2, 2021-02-02
+// By the MadGraph5_aMC@NLO Development Team
+// Visit launchpad.net/madgraph5 and amcatnlo.web.cern.ch
+// File based on main25.cc in Pythia 8.149
+//==========================================================================
+
+#include "Pythia8/Pythia.h"
+#include "Sigma_VLQ_gg_xxx.h"
+#include "Sigma_VLQ_gg_tptpx.h"
+#include "Sigma_VLQ_gg_bpbpx.h"
+#include "Sigma_VLQ_gg_yyx.h"
+#include "Sigma_VLQ_uux_xxx.h"
+#include "Sigma_VLQ_ccx_xxx.h"
+#include "Sigma_VLQ_ddx_xxx.h"
+#include "Sigma_VLQ_ssx_xxx.h"
+#include "Sigma_VLQ_uux_tptpx.h"
+#include "Sigma_VLQ_ccx_tptpx.h"
+#include "Sigma_VLQ_ddx_tptpx.h"
+#include "Sigma_VLQ_ssx_tptpx.h"
+#include "Sigma_VLQ_uux_bpbpx.h"
+#include "Sigma_VLQ_ccx_bpbpx.h"
+#include "Sigma_VLQ_ddx_bpbpx.h"
+#include "Sigma_VLQ_ssx_bpbpx.h"
+#include "Sigma_VLQ_uux_yyx.h"
+#include "Sigma_VLQ_ccx_yyx.h"
+#include "Sigma_VLQ_ddx_yyx.h"
+#include "Sigma_VLQ_ssx_yyx.h"
+
+using namespace Pythia8; 
+
+int main() 
+{
+
+  // Number of events to generate and to list. Max number of errors.
+  // Warning: generation of complete events is much slower than if you use
+  // PartonLevel:all = off to only get cross sections, so adjust nEvent.
+  int nEvent = 3000; 
+  int nAbort = 5; 
+
+  // Pythia generator.
+  Pythia pythia; 
+
+  // Read param_card file
+  pythia.readString("SLHA:file = ../Processes_VLQ/param_card_VLQ.dat"); 
+
+  // Provide process pointers to Pythia
+  pythia.setSigmaPtr(new Sigma_VLQ_gg_xxx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_gg_tptpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_gg_bpbpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_gg_yyx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_uux_xxx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ccx_xxx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ddx_xxx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ssx_xxx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_uux_tptpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ccx_tptpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ddx_tptpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ssx_tptpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_uux_bpbpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ccx_bpbpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ddx_bpbpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ssx_bpbpx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_uux_yyx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ccx_yyx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ddx_yyx()); 
+  pythia.setSigmaPtr(new Sigma_VLQ_ssx_yyx()); 
+
+  // Phase space cut on pThat.
+  pythia.readString("PhaseSpace:pTHatMin = 20."); 
+
+  // Optionally only compare cross sections.
+  pythia.readString("PartonLevel:all = off"); 
+
+  // Initialization for LHC.
+  pythia.init(); 
+
+  // List changes.
+  pythia.settings.listChanged(); 
+  pythia.particleData.listChanged(); 
+
+  // Begin event loop.
+  int iAbort = 0; 
+  for (int iEvent = 0; iEvent < nEvent; ++ iEvent)
+  {
+    if (iEvent%(max(1, nEvent/20)) == 0)
+      cout <<  " Now begin event " << iEvent <<  "\n"; 
+
+    // Generate events. Quit if many failures.
+    if ( !pythia.next())
+    {
+      if (++ iAbort < nAbort)
+        continue; 
+      cout <<  " Event generation aborted prematurely, owing to error!\n"; 
+      break; 
+    }
+
+    // End of event loop.
+  }
+
+  // Final statistics.
+  pythia.stat(); 
+
+  // Done.
+  return 0; 
+}
+
