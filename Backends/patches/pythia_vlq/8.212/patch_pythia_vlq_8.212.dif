+    std::complex<double> COUP3, std::complex<double> COUP4,
+    std::complex<double> COUP5, std::complex<double> COUP6, double M1, double
+    W1, std::complex<double> V1[])
+{
+  std::complex<double> Vtmp[6]; 
+  int i; 
+  VVV1_1(V2, V3, COUP1, M1, W1, V1); 
+  VVV2_1(V2, V3, COUP2, M1, W1, Vtmp); 
+  i = 2; 
