+  OM4 = 0.; 
+  if (M4 != 0.)
+    OM4 = 1./(M4 * M4); 
+  V4[0] = +V1[0] + V2[0] + V3[0]; 
+  V4[1] = +V1[1] + V2[1] + V3[1]; 
