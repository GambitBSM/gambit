+double Sigma_VLQ_ssx_xxx::sigmaHat() 
+{
+  // Select between the different processes
+  if(id1 == -3 && id2 == 3)
+  {
+    // Add matrix elements for processes with beams (-3, 3)
+    return matrix_element[1]; 
+  }
+  else if(id1 == 3 && id2 == -3)
