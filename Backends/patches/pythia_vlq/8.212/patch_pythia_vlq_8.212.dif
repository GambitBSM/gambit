+      V4[2]))) + (P2[2] * (V1[2] * (V3[3] * V4[5] - V3[5] * V4[3]) + (V1[3] *
+      (-V3[2] * V4[5] + V3[5] * V4[2]) + V1[5] * (V3[2] * V4[3] - V3[3] *
+      V4[2]))) + P2[3] * (V1[2] * (-V3[3] * V4[4] + V3[4] * V4[3]) + (V1[3] *
