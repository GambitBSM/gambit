+  TMP22 = (V3[2] * P3[0] - V3[3] * P3[1] - V3[4] * P3[2] - V3[5] * P3[3]); 
+  TMP21 = (P2[0] * V3[2] - P2[1] * V3[3] - P2[2] * V3[4] - P2[3] * V3[5]); 
+  TMP7 = (P1[0] * P2[0] - P1[1] * P2[1] - P1[2] * P2[2] - P1[3] * P2[3]); 
+  TMP25 = (V2[2] * V3[2] - V2[3] * V3[3] - V2[4] * V3[4] - V2[5] * V3[5]); 
+  TMP27 = (P1[0] * P3[0] - P1[1] * P3[1] - P1[2] * P3[2] - P1[3] * P3[3]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * 11./17. * (OM1 * P1[0] * (TMP10 * (-cI * (TMP21) + 3./11. *
+      cI * (TMP22)) + (TMP20 * 3./11. * (-cI * (TMP5) + 11./3. * cI * (TMP24))
+      + 14./11. * (TMP25 * (+cI * (TMP7) - cI * (TMP27))))) + (V2[2] *
+      (-17./11.) * (+cI * (TMP20) - 11./17. * cI * (TMP21) + 3./17. * cI *
+      (TMP22)) + (V3[2] * 17./11. * (+cI * (TMP10) + 3./17. * cI * (TMP5) -
+      11./17. * cI * (TMP24)) + 14./11. * (TMP25 * (-cI * (P2[0]) + cI *
+      (P3[0]))))));
+  V1[3] = denom * 11./17. * (OM1 * P1[1] * (TMP10 * (-cI * (TMP21) + 3./11. *
+      cI * (TMP22)) + (TMP20 * 3./11. * (-cI * (TMP5) + 11./3. * cI * (TMP24))
+      + 14./11. * (TMP25 * (+cI * (TMP7) - cI * (TMP27))))) + (V2[3] *
+      (-17./11.) * (+cI * (TMP20) - 11./17. * cI * (TMP21) + 3./17. * cI *
+      (TMP22)) + (V3[3] * 17./11. * (+cI * (TMP10) + 3./17. * cI * (TMP5) -
+      11./17. * cI * (TMP24)) + 14./11. * (TMP25 * (-cI * (P2[1]) + cI *
+      (P3[1]))))));
+  V1[4] = denom * 11./17. * (OM1 * P1[2] * (TMP10 * (-cI * (TMP21) + 3./11. *
+      cI * (TMP22)) + (TMP20 * 3./11. * (-cI * (TMP5) + 11./3. * cI * (TMP24))
+      + 14./11. * (TMP25 * (+cI * (TMP7) - cI * (TMP27))))) + (V2[4] *
+      (-17./11.) * (+cI * (TMP20) - 11./17. * cI * (TMP21) + 3./17. * cI *
+      (TMP22)) + (V3[4] * 17./11. * (+cI * (TMP10) + 3./17. * cI * (TMP5) -
+      11./17. * cI * (TMP24)) + 14./11. * (TMP25 * (-cI * (P2[2]) + cI *
+      (P3[2]))))));
+  V1[5] = denom * 11./17. * (OM1 * P1[3] * (TMP10 * (-cI * (TMP21) + 3./11. *
+      cI * (TMP22)) + (TMP20 * 3./11. * (-cI * (TMP5) + 11./3. * cI * (TMP24))
+      + 14./11. * (TMP25 * (+cI * (TMP7) - cI * (TMP27))))) + (V2[5] *
+      (-17./11.) * (+cI * (TMP20) - 11./17. * cI * (TMP21) + 3./17. * cI *
+      (TMP22)) + (V3[5] * 17./11. * (+cI * (TMP10) + 3./17. * cI * (TMP5) -
+      11./17. * cI * (TMP24)) + 14./11. * (TMP25 * (-cI * (P2[3]) + cI *
+      (P3[3]))))));
+}
