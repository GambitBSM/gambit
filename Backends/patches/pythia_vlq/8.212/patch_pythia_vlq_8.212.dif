+      setw(10) << GC_15 << endl;
+  cout << setw(20) <<  "GC_16 " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << GC_16 << endl;
+  cout << setw(20) <<  "GC_17 " <<  "= " << setiosflags(ios::scientific) <<
+      setw(10) << GC_17 << endl;
+}
+
+
