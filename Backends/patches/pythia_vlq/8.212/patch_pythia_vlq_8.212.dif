+  P2[3] = -V2[0].imag(); 
+  TMP41 = (V3[2] * V4[2] - V3[3] * V4[3] - V3[4] * V4[4] - V3[5] * V4[5]); 
+  TMP23 = (V1[2] * V3[2] - V1[3] * V3[3] - V1[4] * V3[4] - V1[5] * V3[5]); 
+  TMP39 = (P2[0] * V4[2] - P2[1] * V4[3] - P2[2] * V4[4] - P2[3] * V4[5]); 
+  TMP6 = (P2[0] * V1[2] - P2[1] * V1[3] - P2[2] * V1[4] - P2[3] * V1[5]); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  V2[2] = denom * (OM2 * P2[0] * (+cI * (TMP23 * TMP39) - cI * (TMP6 * TMP41))
+      + (-cI * (TMP23 * V4[2]) + cI * (V1[2] * TMP41)));
+  V2[3] = denom * (OM2 * P2[1] * (+cI * (TMP23 * TMP39) - cI * (TMP6 * TMP41))
+      + (-cI * (TMP23 * V4[3]) + cI * (V1[3] * TMP41)));
+  V2[4] = denom * (OM2 * P2[2] * (+cI * (TMP23 * TMP39) - cI * (TMP6 * TMP41))
+      + (-cI * (TMP23 * V4[4]) + cI * (V1[4] * TMP41)));
+  V2[5] = denom * (OM2 * P2[3] * (+cI * (TMP23 * TMP39) - cI * (TMP6 * TMP41))
+      + (-cI * (TMP23 * V4[5]) + cI * (V1[5] * TMP41)));
+}
