+      + (-cI * (V1[3] * TMP38) + cI * (TMP9 * V4[3])));
+  V3[4] = denom * (OM3 * P3[2] * (+cI * (TMP26 * TMP38) - cI * (TMP9 * TMP42))
+      + (-cI * (V1[4] * TMP38) + cI * (TMP9 * V4[4])));
+  V3[5] = denom * (OM3 * P3[3] * (+cI * (TMP26 * TMP38) - cI * (TMP9 * TMP42))
