+void VVV3_2(std::complex<double> V1[], std::complex<double> V3[],
+    std::complex<double> COUP, double M2, double W2, std::complex<double> V2[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM2; 
+  double P1[4]; 
+  double P2[4]; 
+  double P3[4]; 
+  std::complex<double> TMP20; 
+  std::complex<double> TMP21; 
+  std::complex<double> TMP22; 
+  std::complex<double> TMP23; 
+  std::complex<double> TMP26; 
+  std::complex<double> TMP28; 
+  std::complex<double> TMP6; 
+  std::complex<double> TMP7; 
+  std::complex<double> TMP8; 
+  std::complex<double> denom; 
+  P1[0] = V1[0].real(); 
+  P1[1] = V1[1].real(); 
+  P1[2] = V1[1].imag(); 
+  P1[3] = V1[0].imag(); 
+  OM2 = 0.; 
+  if (M2 != 0.)
+    OM2 = 1./(M2 * M2); 
+  P3[0] = V3[0].real(); 
+  P3[1] = V3[1].real(); 
+  P3[2] = V3[1].imag(); 
+  P3[3] = V3[0].imag(); 
+  V2[0] = +V1[0] + V3[0]; 
+  V2[1] = +V1[1] + V3[1]; 
+  P2[0] = -V2[0].real(); 
+  P2[1] = -V2[1].real(); 
+  P2[2] = -V2[1].imag(); 
+  P2[3] = -V2[0].imag(); 
+  TMP6 = (P2[0] * V1[2] - P2[1] * V1[3] - P2[2] * V1[4] - P2[3] * V1[5]); 
+  TMP23 = (V1[2] * V3[2] - V1[3] * V3[3] - V1[4] * V3[4] - V1[5] * V3[5]); 
+  TMP20 = (P1[0] * V3[2] - P1[1] * V3[3] - P1[2] * V3[4] - P1[3] * V3[5]); 
+  TMP22 = (V3[2] * P3[0] - V3[3] * P3[1] - V3[4] * P3[2] - V3[5] * P3[3]); 
+  TMP28 = (P2[0] * P3[0] - P2[1] * P3[1] - P2[2] * P3[2] - P2[3] * P3[3]); 
+  TMP21 = (P2[0] * V3[2] - P2[1] * V3[3] - P2[2] * V3[4] - P2[3] * V3[5]); 
+  TMP7 = (P1[0] * P2[0] - P1[1] * P2[1] - P1[2] * P2[2] - P1[3] * P2[3]); 
+  TMP26 = (V1[2] * P3[0] - V1[3] * P3[1] - V1[4] * P3[2] - V1[5] * P3[3]); 
+  TMP8 = (P2[0] * P2[0] - P2[1] * P2[1] - P2[2] * P2[2] - P2[3] * P2[3]); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  V2[2] = denom * (P2[0] * (OM2 * (TMP23 * (-1.) * (+cI * (TMP7) + 3./17. * cI
+      * (TMP8) - 11./17. * cI * (TMP28)) + (TMP6 * (+cI * (TMP20) + 3./17. * cI
+      * (TMP21) + 3./17. * cI * (TMP22)) - 14./17. * cI * (TMP21 * TMP26))) +
+      3./17. * cI * (TMP23)) + (V1[2] * (-1.) * (+cI * (TMP20) - 11./17. * cI *
+      (TMP21) + 3./17. * cI * (TMP22)) + (TMP23 * (+cI * (P1[0]) - 11./17. * cI
+      * (P3[0])) + 14./17. * (V3[2] * (-cI * (TMP6) + cI * (TMP26))))));
+  V2[3] = denom * (P2[1] * (OM2 * (TMP23 * (-1.) * (+cI * (TMP7) + 3./17. * cI
+      * (TMP8) - 11./17. * cI * (TMP28)) + (TMP6 * (+cI * (TMP20) + 3./17. * cI
+      * (TMP21) + 3./17. * cI * (TMP22)) - 14./17. * cI * (TMP21 * TMP26))) +
+      3./17. * cI * (TMP23)) + (V1[3] * (-1.) * (+cI * (TMP20) - 11./17. * cI *
+      (TMP21) + 3./17. * cI * (TMP22)) + (TMP23 * (+cI * (P1[1]) - 11./17. * cI
+      * (P3[1])) + 14./17. * (V3[3] * (-cI * (TMP6) + cI * (TMP26))))));
+  V2[4] = denom * (P2[2] * (OM2 * (TMP23 * (-1.) * (+cI * (TMP7) + 3./17. * cI
+      * (TMP8) - 11./17. * cI * (TMP28)) + (TMP6 * (+cI * (TMP20) + 3./17. * cI
+      * (TMP21) + 3./17. * cI * (TMP22)) - 14./17. * cI * (TMP21 * TMP26))) +
+      3./17. * cI * (TMP23)) + (V1[4] * (-1.) * (+cI * (TMP20) - 11./17. * cI *
+      (TMP21) + 3./17. * cI * (TMP22)) + (TMP23 * (+cI * (P1[2]) - 11./17. * cI
+      * (P3[2])) + 14./17. * (V3[4] * (-cI * (TMP6) + cI * (TMP26))))));
+  V2[5] = denom * (P2[3] * (OM2 * (TMP23 * (-1.) * (+cI * (TMP7) + 3./17. * cI
+      * (TMP8) - 11./17. * cI * (TMP28)) + (TMP6 * (+cI * (TMP20) + 3./17. * cI
+      * (TMP21) + 3./17. * cI * (TMP22)) - 14./17. * cI * (TMP21 * TMP26))) +
+      3./17. * cI * (TMP23)) + (V1[5] * (-1.) * (+cI * (TMP20) - 11./17. * cI *
+      (TMP21) + 3./17. * cI * (TMP22)) + (TMP23 * (+cI * (P1[3]) - 11./17. * cI
+      * (P3[3])) + 14./17. * (V3[5] * (-cI * (TMP6) + cI * (TMP26))))));
+}
