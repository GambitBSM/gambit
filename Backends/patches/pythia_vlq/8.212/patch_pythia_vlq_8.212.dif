+  GC_63 = mdl_complexi * mdl_KTRh1; 
+  GC_64 = mdl_complexi * mdl_KTRh2; 
+  GC_65 = mdl_complexi * mdl_KTRh3; 
+}
+
+void Parameters_VLQ::setDependentParameters(ParticleData * & pd, Couplings * &
+    csm, SusyLesHouches * & slhaPtr, double alpS)
+{
+  aS = alpS; 
+  mdl_sqrt__aS = sqrt(aS); 
+  G = 2. * mdl_sqrt__aS * sqrt(M_PI); 
+  mdl_G__exp__2 = ((G) * (G)); 
+}
+
+
+void Parameters_VLQ::setDependentCouplings()
+{
+  GC_13 = -G; 
+  GC_14 = mdl_complexi * G; 
+  GC_15 = G; 
+  GC_16 = -(mdl_complexi * mdl_G__exp__2); 
+  GC_17 = mdl_complexi * mdl_G__exp__2; 
+}
