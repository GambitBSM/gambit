+  denom = COUP/((P4[0] * P4[0]) - (P4[1] * P4[1]) - (P4[2] * P4[2]) - (P4[3] *
+      P4[3]) - M4 * (M4 - cI * W4));
+  V4[2] = denom * - cI * TMP19 * V1[2]; 
+  V4[3] = denom * - cI * TMP19 * V1[3]; 
+  V4[4] = denom * - cI * TMP19 * V1[4]; 
+  V4[5] = denom * - cI * TMP19 * V1[5]; 
