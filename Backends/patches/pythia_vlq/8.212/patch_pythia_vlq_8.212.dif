+void VVVV1_3(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> V4[], std::complex<double> COUP, double M3, double W3,
+    std::complex<double> V3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM3; 
+  double P3[4]; 
+  std::complex<double> TMP18; 
+  std::complex<double> TMP20; 
+  std::complex<double> denom; 
+  OM3 = 0.; 
+  if (M3 != 0.)
+    OM3 = 1./(M3 * M3); 
+  V3[0] = +V1[0] + V2[0] + V4[0]; 
+  V3[1] = +V1[1] + V2[1] + V4[1]; 
+  P3[0] = -V3[0].real(); 
+  P3[1] = -V3[1].real(); 
+  P3[2] = -V3[1].imag(); 
+  P3[3] = -V3[0].imag(); 
+  TMP18 = (P3[0] * V2[2] - P3[1] * V2[3] - P3[2] * V2[4] - P3[3] * V2[5]); 
+  TMP20 = (V1[2] * V4[2] - V1[3] * V4[3] - V1[4] * V4[4] - V1[5] * V4[5]); 
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * TMP20 * (-cI * (V2[2]) + cI * (P3[0] * OM3 * TMP18)); 
+  V3[3] = denom * TMP20 * (-cI * (V2[3]) + cI * (P3[1] * OM3 * TMP18)); 
+  V3[4] = denom * TMP20 * (-cI * (V2[4]) + cI * (P3[2] * OM3 * TMP18)); 
+  V3[5] = denom * TMP20 * (-cI * (V2[5]) + cI * (P3[3] * OM3 * TMP18)); 
+}
+
+void VVVV1_3_3(std::complex<double> V1[], std::complex<double> V2[],
