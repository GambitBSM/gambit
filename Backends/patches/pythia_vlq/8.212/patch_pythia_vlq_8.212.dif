+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * (OM1 * P1[0] * (+cI * (TMP20 * TMP38) - cI * (TMP10 * TMP41))
+      + (-cI * (V3[2] * TMP38) + cI * (V2[2] * TMP41)));
+  V1[3] = denom * (OM1 * P1[1] * (+cI * (TMP20 * TMP38) - cI * (TMP10 * TMP41))
