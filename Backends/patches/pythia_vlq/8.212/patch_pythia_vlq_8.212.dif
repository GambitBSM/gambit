+      * (V3[4]))))) + M2 * (F1[2] * (-1.) * (V3[2] + V3[5]) + F1[3] * (-V3[3] +
+      cI * (V3[4])))));
+  F2[5] = denom * cI * (F1[4] * (P2[0] * (-1.) * (V3[3] + cI * (V3[4])) +
+      (P2[1] * (V3[2] - V3[5]) + (P2[2] * (+cI * (V3[2]) - cI * (V3[5])) +
+      P2[3] * (V3[3] + cI * (V3[4]))))) + (F1[5] * (P2[0] * (V3[2] + V3[5]) +
+      (P2[1] * (-V3[3] + cI * (V3[4])) + (P2[2] * (-1.) * (+cI * (V3[3]) +
+      V3[4]) - P2[3] * (V3[2] + V3[5])))) + M2 * (F1[2] * (V3[3] + cI *
+      (V3[4])) + F1[3] * (V3[2] - V3[5]))));
+}
+
+
+void FFV1_3(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> COUP, double M3, double W3, std::complex<double> V3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM3; 
+  double P3[4]; 
+  std::complex<double> TMP13; 
+  std::complex<double> denom; 
+  OM3 = 0.; 
+  if (M3 != 0.)
+    OM3 = 1./(M3 * M3); 
+  V3[0] = +F1[0] + F2[0]; 
+  V3[1] = +F1[1] + F2[1]; 
+  P3[0] = -V3[0].real(); 
+  P3[1] = -V3[1].real(); 
+  P3[2] = -V3[1].imag(); 
+  P3[3] = -V3[0].imag(); 
+  TMP13 = (F1[2] * (F2[4] * (P3[0] + P3[3]) + F2[5] * (P3[1] + cI * (P3[2]))) +
+      (F1[3] * (F2[4] * (P3[1] - cI * (P3[2])) + F2[5] * (P3[0] - P3[3])) +
+      (F1[4] * (F2[2] * (P3[0] - P3[3]) - F2[3] * (P3[1] + cI * (P3[2]))) +
+      F1[5] * (F2[2] * (-P3[1] + cI * (P3[2])) + F2[3] * (P3[0] + P3[3])))));
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * (-cI) * (F2[4] * F1[2] + F2[5] * F1[3] + F2[2] * F1[4] +
+      F2[3] * F1[5] - P3[0] * OM3 * TMP13);
+  V3[3] = denom * (-cI) * (-F2[5] * F1[2] - F2[4] * F1[3] - P3[1] * OM3 * TMP13
+      + F2[3] * F1[4] + F2[2] * F1[5]);
+  V3[4] = denom * (-cI) * (-cI * (F2[5] * F1[2] + F2[2] * F1[5]) + cI * (F2[4]
+      * F1[3] + F2[3] * F1[4]) - P3[2] * OM3 * TMP13);
+  V3[5] = denom * (-cI) * (-F2[4] * F1[2] - F2[3] * F1[5] - P3[3] * OM3 * TMP13
+      + F2[5] * F1[3] + F2[2] * F1[4]);
+}
