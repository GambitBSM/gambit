+      * (TMP6 * TMP20) - cI * (TMP21 * TMP26))) + (TMP23 * (+cI * (P1[1]) - cI
+      * (P3[1])) + (V1[3] * (-cI * (TMP20) + cI * (TMP21)) + V3[3] * (-cI *
+      (TMP6) + cI * (TMP26)))));
