+      P2[3]) - M2 * (M2 - cI * W2));
+  V2[2] = denom * TMP17 * (-cI * (V4[2]) + cI * (P2[0] * OM2 * TMP24)); 
+  V2[3] = denom * TMP17 * (-cI * (V4[3]) + cI * (P2[1] * OM2 * TMP24)); 
+  V2[4] = denom * TMP17 * (-cI * (V4[4]) + cI * (P2[2] * OM2 * TMP24)); 
