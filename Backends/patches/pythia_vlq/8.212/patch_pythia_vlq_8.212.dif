+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * (OM3 * P3[0] * (+cI * (TMP26 * TMP38) - cI * (TMP9 * TMP42))
