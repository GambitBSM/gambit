+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P1[4]; 
+  double P3[4]; 
+  std::complex<double> TMP12; 
+  std::complex<double> denom; 
+  P1[0] = V1[0].real(); 
+  P1[1] = V1[1].real(); 
+  P1[2] = V1[1].imag(); 
+  P1[3] = V1[0].imag(); 
+  V3[0] = +V1[0] + V2[0]; 
+  V3[1] = +V1[1] + V2[1]; 
+  P3[0] = -V3[0].real(); 
+  P3[1] = -V3[1].real(); 
+  P3[2] = -V3[1].imag(); 
+  P3[3] = -V3[0].imag(); 
+  TMP12 = (V1[2] * V2[2] - V1[3] * V2[3] - V1[4] * V2[4] - V1[5] * V2[5]); 
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * - cI * TMP12 * P1[0]; 
+  V3[3] = denom * - cI * TMP12 * P1[1]; 
+  V3[4] = denom * - cI * TMP12 * P1[2]; 
+  V3[5] = denom * - cI * TMP12 * P1[3]; 
