+
+void VVVV9_0(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> V3[], std::complex<double> V4[], std::complex<double>
+    COUP, std::complex<double> & vertex)
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  std::complex<double> TMP23; 
+  std::complex<double> TMP25; 
+  std::complex<double> TMP35; 
+  std::complex<double> TMP38; 
+  std::complex<double> TMP41; 
+  std::complex<double> TMP9; 
+  TMP35 = (V1[2] * V4[2] - V1[3] * V4[3] - V1[4] * V4[4] - V1[5] * V4[5]); 
+  TMP9 = (V2[2] * V1[2] - V2[3] * V1[3] - V2[4] * V1[4] - V2[5] * V1[5]); 
+  TMP38 = (V2[2] * V4[2] - V2[3] * V4[3] - V2[4] * V4[4] - V2[5] * V4[5]); 
+  TMP23 = (V1[2] * V3[2] - V1[3] * V3[3] - V1[4] * V3[4] - V1[5] * V3[5]); 
+  TMP25 = (V2[2] * V3[2] - V2[3] * V3[3] - V2[4] * V3[4] - V2[5] * V3[5]); 
+  TMP41 = (V3[2] * V4[2] - V3[3] * V4[3] - V3[4] * V4[4] - V3[5] * V4[5]); 
+  vertex = COUP * 1./2. * (-2. * cI * (TMP25 * TMP35) + cI * (TMP23 * TMP38 +
+      TMP9 * TMP41));
+}
+
+
+void VVVV9_1(std::complex<double> V2[], std::complex<double> V3[],
+    std::complex<double> V4[], std::complex<double> COUP, double M1, double W1,
+    std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM1; 
+  double P1[4]; 
+  std::complex<double> TMP10; 
+  std::complex<double> TMP20; 
+  std::complex<double> TMP25; 
+  std::complex<double> TMP36; 
+  std::complex<double> TMP38; 
+  std::complex<double> TMP41; 
+  std::complex<double> denom; 
+  OM1 = 0.; 
+  if (M1 != 0.)
+    OM1 = 1./(M1 * M1); 
+  V1[0] = +V2[0] + V3[0] + V4[0]; 
+  V1[1] = +V2[1] + V3[1] + V4[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  TMP10 = (P1[0] * V2[2] - P1[1] * V2[3] - P1[2] * V2[4] - P1[3] * V2[5]); 
+  TMP38 = (V2[2] * V4[2] - V2[3] * V4[3] - V2[4] * V4[4] - V2[5] * V4[5]); 
+  TMP20 = (P1[0] * V3[2] - P1[1] * V3[3] - P1[2] * V3[4] - P1[3] * V3[5]); 
+  TMP25 = (V2[2] * V3[2] - V2[3] * V3[3] - V2[4] * V3[4] - V2[5] * V3[5]); 
+  TMP41 = (V3[2] * V4[2] - V3[3] * V4[3] - V3[4] * V4[4] - V3[5] * V4[5]); 
+  TMP36 = (P1[0] * V4[2] - P1[1] * V4[3] - P1[2] * V4[4] - P1[3] * V4[5]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * 1./2. * (OM1 * - P1[0] * (-2. * cI * (TMP25 * TMP36) + cI *
+      (TMP20 * TMP38 + TMP10 * TMP41)) + (-2. * cI * (TMP25 * V4[2]) + cI *
+      (V3[2] * TMP38 + V2[2] * TMP41)));
+  V1[3] = denom * 1./2. * (OM1 * - P1[1] * (-2. * cI * (TMP25 * TMP36) + cI *
+      (TMP20 * TMP38 + TMP10 * TMP41)) + (-2. * cI * (TMP25 * V4[3]) + cI *
+      (V3[3] * TMP38 + V2[3] * TMP41)));
+  V1[4] = denom * 1./2. * (OM1 * - P1[2] * (-2. * cI * (TMP25 * TMP36) + cI *
+      (TMP20 * TMP38 + TMP10 * TMP41)) + (-2. * cI * (TMP25 * V4[4]) + cI *
+      (V3[4] * TMP38 + V2[4] * TMP41)));
+  V1[5] = denom * 1./2. * (OM1 * - P1[3] * (-2. * cI * (TMP25 * TMP36) + cI *
+      (TMP20 * TMP38 + TMP10 * TMP41)) + (-2. * cI * (TMP25 * V4[5]) + cI *
+      (V3[5] * TMP38 + V2[5] * TMP41)));
+}
+
+
+void VVVV9_2(std::complex<double> V1[], std::complex<double> V3[],
+    std::complex<double> V4[], std::complex<double> COUP, double M2, double W2,
+    std::complex<double> V2[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM2; 
+  double P2[4]; 
+  std::complex<double> TMP21; 
+  std::complex<double> TMP23; 
+  std::complex<double> TMP35; 
+  std::complex<double> TMP39; 
+  std::complex<double> TMP41; 
+  std::complex<double> TMP6; 
+  std::complex<double> denom; 
+  OM2 = 0.; 
+  if (M2 != 0.)
+    OM2 = 1./(M2 * M2); 
+  V2[0] = +V1[0] + V3[0] + V4[0]; 
+  V2[1] = +V1[1] + V3[1] + V4[1]; 
+  P2[0] = -V2[0].real(); 
+  P2[1] = -V2[1].real(); 
+  P2[2] = -V2[1].imag(); 
+  P2[3] = -V2[0].imag(); 
+  TMP35 = (V1[2] * V4[2] - V1[3] * V4[3] - V1[4] * V4[4] - V1[5] * V4[5]); 
+  TMP6 = (P2[0] * V1[2] - P2[1] * V1[3] - P2[2] * V1[4] - P2[3] * V1[5]); 
+  TMP23 = (V1[2] * V3[2] - V1[3] * V3[3] - V1[4] * V3[4] - V1[5] * V3[5]); 
+  TMP21 = (P2[0] * V3[2] - P2[1] * V3[3] - P2[2] * V3[4] - P2[3] * V3[5]); 
+  TMP41 = (V3[2] * V4[2] - V3[3] * V4[3] - V3[4] * V4[4] - V3[5] * V4[5]); 
+  TMP39 = (P2[0] * V4[2] - P2[1] * V4[3] - P2[2] * V4[4] - P2[3] * V4[5]); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  V2[2] = denom * 1./2. * (OM2 * - P2[0] * (-2. * cI * (TMP21 * TMP35) + cI *
+      (TMP23 * TMP39 + TMP6 * TMP41)) + (-2. * cI * (V3[2] * TMP35) + cI *
+      (TMP23 * V4[2] + V1[2] * TMP41)));
+  V2[3] = denom * 1./2. * (OM2 * - P2[1] * (-2. * cI * (TMP21 * TMP35) + cI *
+      (TMP23 * TMP39 + TMP6 * TMP41)) + (-2. * cI * (V3[3] * TMP35) + cI *
+      (TMP23 * V4[3] + V1[3] * TMP41)));
+  V2[4] = denom * 1./2. * (OM2 * - P2[2] * (-2. * cI * (TMP21 * TMP35) + cI *
+      (TMP23 * TMP39 + TMP6 * TMP41)) + (-2. * cI * (V3[4] * TMP35) + cI *
+      (TMP23 * V4[4] + V1[4] * TMP41)));
+  V2[5] = denom * 1./2. * (OM2 * - P2[3] * (-2. * cI * (TMP21 * TMP35) + cI *
+      (TMP23 * TMP39 + TMP6 * TMP41)) + (-2. * cI * (V3[5] * TMP35) + cI *
+      (TMP23 * V4[5] + V1[5] * TMP41)));
+}
+
+
+void VVVV9_3(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> V4[], std::complex<double> COUP, double M3, double W3,
+    std::complex<double> V3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM3; 
+  double P3[4]; 
+  std::complex<double> TMP24; 
+  std::complex<double> TMP26; 
+  std::complex<double> TMP35; 
+  std::complex<double> TMP38; 
+  std::complex<double> TMP42; 
+  std::complex<double> TMP9; 
+  std::complex<double> denom; 
+  OM3 = 0.; 
+  if (M3 != 0.)
+    OM3 = 1./(M3 * M3); 
+  V3[0] = +V1[0] + V2[0] + V4[0]; 
+  V3[1] = +V1[1] + V2[1] + V4[1]; 
+  P3[0] = -V3[0].real(); 
+  P3[1] = -V3[1].real(); 
+  P3[2] = -V3[1].imag(); 
+  P3[3] = -V3[0].imag(); 
+  TMP35 = (V1[2] * V4[2] - V1[3] * V4[3] - V1[4] * V4[4] - V1[5] * V4[5]); 
+  TMP9 = (V2[2] * V1[2] - V2[3] * V1[3] - V2[4] * V1[4] - V2[5] * V1[5]); 
+  TMP38 = (V2[2] * V4[2] - V2[3] * V4[3] - V2[4] * V4[4] - V2[5] * V4[5]); 
+  TMP42 = (P3[0] * V4[2] - P3[1] * V4[3] - P3[2] * V4[4] - P3[3] * V4[5]); 
+  TMP24 = (V2[2] * P3[0] - V2[3] * P3[1] - V2[4] * P3[2] - V2[5] * P3[3]); 
+  TMP26 = (V1[2] * P3[0] - V1[3] * P3[1] - V1[4] * P3[2] - V1[5] * P3[3]); 
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * 1./2. * (OM3 * - P3[0] * (-2. * cI * (TMP24 * TMP35) + cI *
+      (TMP26 * TMP38 + TMP9 * TMP42)) + (-2. * cI * (V2[2] * TMP35) + cI *
+      (V1[2] * TMP38 + TMP9 * V4[2])));
+  V3[3] = denom * 1./2. * (OM3 * - P3[1] * (-2. * cI * (TMP24 * TMP35) + cI *
+      (TMP26 * TMP38 + TMP9 * TMP42)) + (-2. * cI * (V2[3] * TMP35) + cI *
+      (V1[3] * TMP38 + TMP9 * V4[3])));
+  V3[4] = denom * 1./2. * (OM3 * - P3[2] * (-2. * cI * (TMP24 * TMP35) + cI *
+      (TMP26 * TMP38 + TMP9 * TMP42)) + (-2. * cI * (V2[4] * TMP35) + cI *
+      (V1[4] * TMP38 + TMP9 * V4[4])));
+  V3[5] = denom * 1./2. * (OM3 * - P3[3] * (-2. * cI * (TMP24 * TMP35) + cI *
+      (TMP26 * TMP38 + TMP9 * TMP42)) + (-2. * cI * (V2[5] * TMP35) + cI *
+      (V1[5] * TMP38 + TMP9 * V4[5])));
+}
+
+
+void VVVV9_4(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> V3[], std::complex<double> COUP, double M4, double W4,
+    std::complex<double> V4[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM4; 
+  double P4[4]; 
+  std::complex<double> TMP23; 
+  std::complex<double> TMP25; 
+  std::complex<double> TMP37; 
+  std::complex<double> TMP40; 
+  std::complex<double> TMP43; 
+  std::complex<double> TMP9; 
+  std::complex<double> denom; 
+  OM4 = 0.; 
+  if (M4 != 0.)
+    OM4 = 1./(M4 * M4); 
+  V4[0] = +V1[0] + V2[0] + V3[0]; 
+  V4[1] = +V1[1] + V2[1] + V3[1]; 
+  P4[0] = -V4[0].real(); 
+  P4[1] = -V4[1].real(); 
+  P4[2] = -V4[1].imag(); 
+  P4[3] = -V4[0].imag(); 
+  TMP9 = (V2[2] * V1[2] - V2[3] * V1[3] - V2[4] * V1[4] - V2[5] * V1[5]); 
+  TMP40 = (V2[2] * P4[0] - V2[3] * P4[1] - V2[4] * P4[2] - V2[5] * P4[3]); 
+  TMP23 = (V1[2] * V3[2] - V1[3] * V3[3] - V1[4] * V3[4] - V1[5] * V3[5]); 
+  TMP43 = (V3[2] * P4[0] - V3[3] * P4[1] - V3[4] * P4[2] - V3[5] * P4[3]); 
+  TMP37 = (V1[2] * P4[0] - V1[3] * P4[1] - V1[4] * P4[2] - V1[5] * P4[3]); 
+  TMP25 = (V2[2] * V3[2] - V2[3] * V3[3] - V2[4] * V3[4] - V2[5] * V3[5]); 
+  denom = COUP/((P4[0] * P4[0]) - (P4[1] * P4[1]) - (P4[2] * P4[2]) - (P4[3] *
+      P4[3]) - M4 * (M4 - cI * W4));
+  V4[2] = denom * 1./2. * (OM4 * - P4[0] * (-2. * cI * (TMP25 * TMP37) + cI *
+      (TMP23 * TMP40 + TMP9 * TMP43)) + (-2. * cI * (V1[2] * TMP25) + cI *
+      (V2[2] * TMP23 + TMP9 * V3[2])));
+  V4[3] = denom * 1./2. * (OM4 * - P4[1] * (-2. * cI * (TMP25 * TMP37) + cI *
+      (TMP23 * TMP40 + TMP9 * TMP43)) + (-2. * cI * (V1[3] * TMP25) + cI *
+      (V2[3] * TMP23 + TMP9 * V3[3])));
+  V4[4] = denom * 1./2. * (OM4 * - P4[2] * (-2. * cI * (TMP25 * TMP37) + cI *
+      (TMP23 * TMP40 + TMP9 * TMP43)) + (-2. * cI * (V1[4] * TMP25) + cI *
+      (V2[4] * TMP23 + TMP9 * V3[4])));
+  V4[5] = denom * 1./2. * (OM4 * - P4[3] * (-2. * cI * (TMP25 * TMP37) + cI *
+      (TMP23 * TMP40 + TMP9 * TMP43)) + (-2. * cI * (V1[5] * TMP25) + cI *
+      (V2[5] * TMP23 + TMP9 * V3[5])));
+}
+
+
+void VVVV9P0_1(std::complex<double> V2[], std::complex<double> V3[],
+    std::complex<double> V4[], std::complex<double> COUP, double M1, double W1,
+    std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P1[4]; 
+  std::complex<double> TMP25; 
+  std::complex<double> TMP38; 
+  std::complex<double> TMP41; 
+  std::complex<double> denom; 
+  V1[0] = +V2[0] + V3[0] + V4[0]; 
+  V1[1] = +V2[1] + V3[1] + V4[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  TMP25 = (V2[2] * V3[2] - V2[3] * V3[3] - V2[4] * V3[4] - V2[5] * V3[5]); 
+  TMP41 = (V3[2] * V4[2] - V3[3] * V4[3] - V3[4] * V4[4] - V3[5] * V4[5]); 
+  TMP38 = (V2[2] * V4[2] - V2[3] * V4[3] - V2[4] * V4[4] - V2[5] * V4[5]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * 1./2. * (-2. * cI * (TMP25 * V4[2]) + cI * (V3[2] * TMP38 +
+      V2[2] * TMP41));
+  V1[3] = denom * 1./2. * (-2. * cI * (TMP25 * V4[3]) + cI * (V3[3] * TMP38 +
+      V2[3] * TMP41));
+  V1[4] = denom * 1./2. * (-2. * cI * (TMP25 * V4[4]) + cI * (V3[4] * TMP38 +
+      V2[4] * TMP41));
+  V1[5] = denom * 1./2. * (-2. * cI * (TMP25 * V4[5]) + cI * (V3[5] * TMP38 +
+      V2[5] * TMP41));
+}
