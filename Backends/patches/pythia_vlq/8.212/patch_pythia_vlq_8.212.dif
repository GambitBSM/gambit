+void VVV1_1(std::complex<double> V2[], std::complex<double> V3[],
+    std::complex<double> COUP, double M1, double W1, std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM1; 
+  double P1[4]; 
+  std::complex<double> TMP13; 
+  std::complex<double> TMP14; 
+  std::complex<double> denom; 
+  OM1 = 0.; 
+  if (M1 != 0.)
+    OM1 = 1./(M1 * M1); 
+  V1[0] = +V2[0] + V3[0]; 
+  V1[1] = +V2[1] + V3[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  TMP14 = (P1[0] * V3[2] - P1[1] * V3[3] - P1[2] * V3[4] - P1[3] * V3[5]); 
+  TMP13 = (P1[0] * V2[2] - P1[1] * V2[3] - P1[2] * V2[4] - P1[3] * V2[5]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * TMP14 * (-cI * (V2[2]) + cI * (P1[0] * OM1 * TMP13)); 
+  V1[3] = denom * TMP14 * (-cI * (V2[3]) + cI * (P1[1] * OM1 * TMP13)); 
+  V1[4] = denom * TMP14 * (-cI * (V2[4]) + cI * (P1[2] * OM1 * TMP13)); 
