+
+void VVVV2_0(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> V3[], std::complex<double> V4[], std::complex<double>
+    COUP, std::complex<double> & vertex)
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  std::complex<double> TMP17; 
+  std::complex<double> TMP23; 
+  TMP17 = (V3[2] * V1[2] - V3[3] * V1[3] - V3[4] * V1[4] - V3[5] * V1[5]); 
+  TMP23 = (V2[2] * V4[2] - V2[3] * V4[3] - V2[4] * V4[4] - V2[5] * V4[5]); 
+  vertex = COUP * - cI * TMP23 * TMP17; 
+}
+
+void VVVV2_3_0(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> V3[], std::complex<double> V4[], std::complex<double>
+    COUP1, std::complex<double> COUP2, std::complex<double> & vertex)
+{
+  std::complex<double> tmp; 
+  VVVV2_0(V1, V2, V3, V4, COUP1, vertex); 
+  VVVV3_0(V1, V2, V3, V4, COUP2, tmp); 
+  vertex = vertex + tmp; 
+}
+
+void VVVV2_1(std::complex<double> V2[], std::complex<double> V3[],
+    std::complex<double> V4[], std::complex<double> COUP, double M1, double W1,
+    std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM1; 
+  double P1[4]; 
+  std::complex<double> TMP14; 
+  std::complex<double> TMP23; 
+  std::complex<double> denom; 
+  OM1 = 0.; 
+  if (M1 != 0.)
+    OM1 = 1./(M1 * M1); 
+  V1[0] = +V2[0] + V3[0] + V4[0]; 
+  V1[1] = +V2[1] + V3[1] + V4[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  TMP14 = (P1[0] * V3[2] - P1[1] * V3[3] - P1[2] * V3[4] - P1[3] * V3[5]); 
+  TMP23 = (V2[2] * V4[2] - V2[3] * V4[3] - V2[4] * V4[4] - V2[5] * V4[5]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * TMP23 * (-cI * (V3[2]) + cI * (P1[0] * OM1 * TMP14)); 
+  V1[3] = denom * TMP23 * (-cI * (V3[3]) + cI * (P1[1] * OM1 * TMP14)); 
+  V1[4] = denom * TMP23 * (-cI * (V3[4]) + cI * (P1[2] * OM1 * TMP14)); 
+  V1[5] = denom * TMP23 * (-cI * (V3[5]) + cI * (P1[3] * OM1 * TMP14)); 
+}
+
+void VVVV2_3_1(std::complex<double> V2[], std::complex<double> V3[],
+    std::complex<double> V4[], std::complex<double> COUP1, std::complex<double>
+    COUP2, double M1, double W1, std::complex<double> V1[])
+{
+  std::complex<double> Vtmp[6]; 
+  int i; 
+  VVVV2_1(V2, V3, V4, COUP1, M1, W1, V1); 
+  VVVV3_1(V2, V3, V4, COUP2, M1, W1, Vtmp); 
+  i = 2; 
+  while (i < 6)
+  {
+    V1[i] = V1[i] + Vtmp[i]; 
+    i++; 
+  }
+}
