+      TMP24))) + 3./17. * cI * (TMP9)) + (V1[3] * (-1.) * (+cI * (TMP10) +
+      3./17. * cI * (TMP5) - 11./17. * cI * (TMP24)) + (TMP9 * (+cI * (P1[1]) -
