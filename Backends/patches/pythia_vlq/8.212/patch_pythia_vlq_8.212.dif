+  double OM1; 
+  double P1[4]; 
+  std::complex<double> TMP10; 
+  std::complex<double> TMP41; 
+  std::complex<double> denom; 
+  OM1 = 0.; 
+  if (M1 != 0.)
+    OM1 = 1./(M1 * M1); 
+  V1[0] = +V2[0] + V3[0] + V4[0]; 
+  V1[1] = +V2[1] + V3[1] + V4[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  TMP41 = (V3[2] * V4[2] - V3[3] * V4[3] - V3[4] * V4[4] - V3[5] * V4[5]); 
+  TMP10 = (P1[0] * V2[2] - P1[1] * V2[3] - P1[2] * V2[4] - P1[3] * V2[5]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * TMP41 * (-cI * (V2[2]) + cI * (P1[0] * OM1 * TMP10)); 
+  V1[3] = denom * TMP41 * (-cI * (V2[3]) + cI * (P1[1] * OM1 * TMP10)); 
+  V1[4] = denom * TMP41 * (-cI * (V2[4]) + cI * (P1[2] * OM1 * TMP10)); 
