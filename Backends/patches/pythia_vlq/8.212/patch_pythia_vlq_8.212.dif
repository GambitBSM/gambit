+      TMP24))) + 3./17. * cI * (TMP9)) + (V1[2] * (-1.) * (+cI * (TMP10) +
+      3./17. * cI * (TMP5) - 11./17. * cI * (TMP24)) + (TMP9 * (+cI * (P1[0]) -
+      11./17. * cI * (P2[0])) + 14./17. * (V2[2] * (+cI * (TMP6) - cI *
+      (TMP26))))));
