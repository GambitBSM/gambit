+  TMP43 = (V3[2] * P4[0] - V3[3] * P4[1] - V3[4] * P4[2] - V3[5] * P4[3]); 
+  denom = COUP/((P4[0] * P4[0]) - (P4[1] * P4[1]) - (P4[2] * P4[2]) - (P4[3] *
+      P4[3]) - M4 * (M4 - cI * W4));
+  V4[2] = denom * (OM4 * P4[0] * (+cI * (TMP23 * TMP40) - cI * (TMP9 * TMP43))
+      + (-cI * (V2[2] * TMP23) + cI * (TMP9 * V3[2])));
+  V4[3] = denom * (OM4 * P4[1] * (+cI * (TMP23 * TMP40) - cI * (TMP9 * TMP43))
+      + (-cI * (V2[3] * TMP23) + cI * (TMP9 * V3[3])));
+  V4[4] = denom * (OM4 * P4[2] * (+cI * (TMP23 * TMP40) - cI * (TMP9 * TMP43))
+      + (-cI * (V2[4] * TMP23) + cI * (TMP9 * V3[4])));
+  V4[5] = denom * (OM4 * P4[3] * (+cI * (TMP23 * TMP40) - cI * (TMP9 * TMP43))
