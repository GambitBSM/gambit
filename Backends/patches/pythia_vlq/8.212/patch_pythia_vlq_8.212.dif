+
+void FFV1_2(std::complex<double> F1[], std::complex<double> V3[],
+    std::complex<double> COUP, double M2, double W2, std::complex<double> F2[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P2[4]; 
+  std::complex<double> denom; 
+  F2[0] = +F1[0] + V3[0]; 
+  F2[1] = +F1[1] + V3[1]; 
+  P2[0] = -F2[0].real(); 
+  P2[1] = -F2[1].real(); 
+  P2[2] = -F2[1].imag(); 
+  P2[3] = -F2[0].imag(); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  F2[2] = denom * cI * (F1[2] * (P2[0] * (V3[2] + V3[5]) + (P2[1] * (-1.) *
+      (V3[3] + cI * (V3[4])) + (P2[2] * (+cI * (V3[3]) - V3[4]) - P2[3] *
+      (V3[2] + V3[5])))) + (F1[3] * (P2[0] * (V3[3] - cI * (V3[4])) + (P2[1] *
+      (-V3[2] + V3[5]) + (P2[2] * (+cI * (V3[2]) - cI * (V3[5])) + P2[3] *
+      (-V3[3] + cI * (V3[4]))))) + M2 * (F1[4] * (V3[2] - V3[5]) + F1[5] *
+      (-V3[3] + cI * (V3[4])))));
+  F2[3] = denom * (-cI) * (F1[2] * (P2[0] * (-1.) * (V3[3] + cI * (V3[4])) +
+      (P2[1] * (V3[2] + V3[5]) + (P2[2] * (+cI * (V3[2] + V3[5])) - P2[3] *
+      (V3[3] + cI * (V3[4]))))) + (F1[3] * (P2[0] * (-V3[2] + V3[5]) + (P2[1] *
+      (V3[3] - cI * (V3[4])) + (P2[2] * (+cI * (V3[3]) + V3[4]) + P2[3] *
+      (-V3[2] + V3[5])))) + M2 * (F1[4] * (V3[3] + cI * (V3[4])) - F1[5] *
+      (V3[2] + V3[5]))));
+  F2[4] = denom * (-cI) * (F1[4] * (P2[0] * (-V3[2] + V3[5]) + (P2[1] * (V3[3]
+      + cI * (V3[4])) + (P2[2] * (-cI * (V3[3]) + V3[4]) + P2[3] * (-V3[2] +
+      V3[5])))) + (F1[5] * (P2[0] * (V3[3] - cI * (V3[4])) + (P2[1] * (-1.) *
+      (V3[2] + V3[5]) + (P2[2] * (+cI * (V3[2] + V3[5])) + P2[3] * (V3[3] - cI
+      * (V3[4]))))) + M2 * (F1[2] * (-1.) * (V3[2] + V3[5]) + F1[3] * (-V3[3] +
+      cI * (V3[4])))));
+  F2[5] = denom * cI * (F1[4] * (P2[0] * (-1.) * (V3[3] + cI * (V3[4])) +
+      (P2[1] * (V3[2] - V3[5]) + (P2[2] * (+cI * (V3[2]) - cI * (V3[5])) +
+      P2[3] * (V3[3] + cI * (V3[4]))))) + (F1[5] * (P2[0] * (V3[2] + V3[5]) +
+      (P2[1] * (-V3[3] + cI * (V3[4])) + (P2[2] * (-1.) * (+cI * (V3[3]) +
+      V3[4]) - P2[3] * (V3[2] + V3[5])))) + M2 * (F1[2] * (V3[3] + cI *
+      (V3[4])) + F1[3] * (V3[2] - V3[5]))));
+}
+
+
+void FFV1_3(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> COUP, double M3, double W3, std::complex<double> V3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM3; 
+  double P3[4]; 
+  std::complex<double> TMP3; 
+  std::complex<double> denom; 
+  OM3 = 0.; 
+  if (M3 != 0.)
+    OM3 = 1./(M3 * M3); 
+  V3[0] = +F1[0] + F2[0]; 
+  V3[1] = +F1[1] + F2[1]; 
+  P3[0] = -V3[0].real(); 
+  P3[1] = -V3[1].real(); 
+  P3[2] = -V3[1].imag(); 
+  P3[3] = -V3[0].imag(); 
+  TMP3 = (F1[2] * (F2[4] * (P3[0] + P3[3]) + F2[5] * (P3[1] + cI * (P3[2]))) +
+      (F1[3] * (F2[4] * (P3[1] - cI * (P3[2])) + F2[5] * (P3[0] - P3[3])) +
+      (F1[4] * (F2[2] * (P3[0] - P3[3]) - F2[3] * (P3[1] + cI * (P3[2]))) +
+      F1[5] * (F2[2] * (-P3[1] + cI * (P3[2])) + F2[3] * (P3[0] + P3[3])))));
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * (-cI) * (F2[4] * F1[2] + F2[5] * F1[3] + F2[2] * F1[4] +
+      F2[3] * F1[5] - P3[0] * OM3 * TMP3);
+  V3[3] = denom * (-cI) * (-F2[5] * F1[2] - F2[4] * F1[3] - P3[1] * OM3 * TMP3
+      + F2[3] * F1[4] + F2[2] * F1[5]);
+  V3[4] = denom * (-cI) * (-cI * (F2[5] * F1[2] + F2[2] * F1[5]) + cI * (F2[4]
+      * F1[3] + F2[3] * F1[4]) - P3[2] * OM3 * TMP3);
+  V3[5] = denom * (-cI) * (-F2[4] * F1[2] - F2[3] * F1[5] - P3[3] * OM3 * TMP3
+      + F2[5] * F1[3] + F2[2] * F1[4]);
+}
+
+
+void FFV1P0_3(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> COUP, double M3, double W3, std::complex<double> V3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P3[4]; 
+  std::complex<double> denom; 
+  V3[0] = +F1[0] + F2[0]; 
+  V3[1] = +F1[1] + F2[1]; 
+  P3[0] = -V3[0].real(); 
+  P3[1] = -V3[1].real(); 
+  P3[2] = -V3[1].imag(); 
+  P3[3] = -V3[0].imag(); 
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * (-cI) * (F2[4] * F1[2] + F2[5] * F1[3] + F2[2] * F1[4] +
+      F2[3] * F1[5]);
+  V3[3] = denom * (-cI) * (-F2[5] * F1[2] - F2[4] * F1[3] + F2[3] * F1[4] +
+      F2[2] * F1[5]);
+  V3[4] = denom * (-cI) * (-cI * (F2[5] * F1[2] + F2[2] * F1[5]) + cI * (F2[4]
+      * F1[3] + F2[3] * F1[4]));
+  V3[5] = denom * (-cI) * (-F2[4] * F1[2] - F2[3] * F1[5] + F2[5] * F1[3] +
+      F2[2] * F1[4]);
+}
+
+
+void FFV2_0(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> V3[], std::complex<double> COUP, std::complex<double>
+    & vertex)
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  std::complex<double> TMP4; 
+  TMP4 = (F1[2] * (F2[4] * (V3[2] + V3[5]) + F2[5] * (V3[3] + cI * (V3[4]))) +
+      F1[3] * (F2[4] * (V3[3] - cI * (V3[4])) + F2[5] * (V3[2] - V3[5])));
+  vertex = COUP * - cI * TMP4; 
+}
+
+void FFV2_3_0(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> V3[], std::complex<double> COUP1, std::complex<double>
+    COUP2, std::complex<double> & vertex)
+{
+  std::complex<double> tmp; 
+  FFV2_0(F1, F2, V3, COUP1, vertex); 
+  FFV3_0(F1, F2, V3, COUP2, tmp); 
+  vertex = vertex + tmp; 
+}
+
+void FFV2_1(std::complex<double> F2[], std::complex<double> V3[],
+    std::complex<double> COUP, double M1, double W1, std::complex<double> F1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P1[4]; 
+  std::complex<double> denom; 
+  F1[0] = +F2[0] + V3[0]; 
+  F1[1] = +F2[1] + V3[1]; 
+  P1[0] = -F1[0].real(); 
+  P1[1] = -F1[1].real(); 
+  P1[2] = -F1[1].imag(); 
+  P1[3] = -F1[0].imag(); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  F1[2] = denom * cI * M1 * (F2[4] * (V3[2] + V3[5]) + F2[5] * (V3[3] + cI *
+      (V3[4])));
+  F1[3] = denom * - cI * M1 * (F2[4] * (-V3[3] + cI * (V3[4])) + F2[5] *
+      (-V3[2] + V3[5]));
+  F1[4] = denom * (-cI) * (F2[4] * (P1[0] * (V3[2] + V3[5]) + (P1[1] * (-V3[3]
+      + cI * (V3[4])) + (P1[2] * (-1.) * (+cI * (V3[3]) + V3[4]) - P1[3] *
+      (V3[2] + V3[5])))) + F2[5] * (P1[0] * (V3[3] + cI * (V3[4])) + (P1[1] *
+      (-V3[2] + V3[5]) + (P1[2] * (-cI * (V3[2]) + cI * (V3[5])) - P1[3] *
+      (V3[3] + cI * (V3[4]))))));
+  F1[5] = denom * (-cI) * (F2[4] * (P1[0] * (V3[3] - cI * (V3[4])) + (P1[1] *
+      (-1.) * (V3[2] + V3[5]) + (P1[2] * (+cI * (V3[2] + V3[5])) + P1[3] *
+      (V3[3] - cI * (V3[4]))))) + F2[5] * (P1[0] * (V3[2] - V3[5]) + (P1[1] *
+      (-1.) * (V3[3] + cI * (V3[4])) + (P1[2] * (+cI * (V3[3]) - V3[4]) + P1[3]
+      * (V3[2] - V3[5])))));
+}
+
+void FFV2_3_1(std::complex<double> F2[], std::complex<double> V3[],
+    std::complex<double> COUP1, std::complex<double> COUP2, double M1, double
+    W1, std::complex<double> F1[])
+{
+  std::complex<double> Ftmp[6]; 
+  int i; 
+  FFV2_1(F2, V3, COUP1, M1, W1, F1); 
+  FFV3_1(F2, V3, COUP2, M1, W1, Ftmp); 
+  i = 2; 
+  while (i < 6)
+  {
+    F1[i] = F1[i] + Ftmp[i]; 
+    i++; 
+  }
+}
+
+void FFV2_2(std::complex<double> F1[], std::complex<double> V3[],
+    std::complex<double> COUP, double M2, double W2, std::complex<double> F2[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P2[4]; 
+  std::complex<double> denom; 
+  F2[0] = +F1[0] + V3[0]; 
+  F2[1] = +F1[1] + V3[1]; 
+  P2[0] = -F2[0].real(); 
+  P2[1] = -F2[1].real(); 
+  P2[2] = -F2[1].imag(); 
+  P2[3] = -F2[0].imag(); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  F2[2] = denom * cI * (F1[2] * (P2[0] * (V3[2] + V3[5]) + (P2[1] * (-1.) *
+      (V3[3] + cI * (V3[4])) + (P2[2] * (+cI * (V3[3]) - V3[4]) - P2[3] *
+      (V3[2] + V3[5])))) + F1[3] * (P2[0] * (V3[3] - cI * (V3[4])) + (P2[1] *
+      (-V3[2] + V3[5]) + (P2[2] * (+cI * (V3[2]) - cI * (V3[5])) + P2[3] *
+      (-V3[3] + cI * (V3[4]))))));
+  F2[3] = denom * cI * (F1[2] * (P2[0] * (V3[3] + cI * (V3[4])) + (P2[1] *
+      (-1.) * (V3[2] + V3[5]) + (P2[2] * (-1.) * (+cI * (V3[2] + V3[5])) +
+      P2[3] * (V3[3] + cI * (V3[4]))))) + F1[3] * (P2[0] * (V3[2] - V3[5]) +
+      (P2[1] * (-V3[3] + cI * (V3[4])) + (P2[2] * (-1.) * (+cI * (V3[3]) +
+      V3[4]) + P2[3] * (V3[2] - V3[5])))));
+  F2[4] = denom * - cI * M2 * (F1[2] * (-1.) * (V3[2] + V3[5]) + F1[3] *
+      (-V3[3] + cI * (V3[4])));
+  F2[5] = denom * cI * M2 * (F1[2] * (V3[3] + cI * (V3[4])) + F1[3] * (V3[2] -
+      V3[5]));
+}
+
+void FFV2_3_2(std::complex<double> F1[], std::complex<double> V3[],
+    std::complex<double> COUP1, std::complex<double> COUP2, double M2, double
+    W2, std::complex<double> F2[])
+{
+  std::complex<double> Ftmp[6]; 
+  int i; 
+  FFV2_2(F1, V3, COUP1, M2, W2, F2); 
+  FFV3_2(F1, V3, COUP2, M2, W2, Ftmp); 
+  i = 2; 
+  while (i < 6)
+  {
+    F2[i] = F2[i] + Ftmp[i]; 
+    i++; 
+  }
+}
+
+void FFV2_3(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> COUP, double M3, double W3, std::complex<double> V3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM3; 
+  double P3[4]; 
+  std::complex<double> TMP5; 
+  std::complex<double> denom; 
+  OM3 = 0.; 
+  if (M3 != 0.)
+    OM3 = 1./(M3 * M3); 
+  V3[0] = +F1[0] + F2[0]; 
+  V3[1] = +F1[1] + F2[1]; 
+  P3[0] = -V3[0].real(); 
+  P3[1] = -V3[1].real(); 
+  P3[2] = -V3[1].imag(); 
+  P3[3] = -V3[0].imag(); 
+  TMP5 = (F1[2] * (F2[4] * (P3[0] + P3[3]) + F2[5] * (P3[1] + cI * (P3[2]))) +
+      F1[3] * (F2[4] * (P3[1] - cI * (P3[2])) + F2[5] * (P3[0] - P3[3])));
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * (-cI) * (F2[4] * F1[2] + F2[5] * F1[3] - P3[0] * OM3 * TMP5); 
+  V3[3] = denom * (-cI) * (-F2[5] * F1[2] - F2[4] * F1[3] - P3[1] * OM3 *
+      TMP5);
+  V3[4] = denom * (-cI) * (-cI * (F2[5] * F1[2]) + cI * (F2[4] * F1[3]) - P3[2]
+      * OM3 * TMP5);
+  V3[5] = denom * (-cI) * (-F2[4] * F1[2] - P3[3] * OM3 * TMP5 + F2[5] *
+      F1[3]);
+}
+
+void FFV2_3_3(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> COUP1, std::complex<double> COUP2, double M3, double
+    W3, std::complex<double> V3[])
+{
+  std::complex<double> Vtmp[6]; 
+  int i; 
+  FFV2_3(F1, F2, COUP1, M3, W3, V3); 
+  FFV3_3(F1, F2, COUP2, M3, W3, Vtmp); 
+  i = 2; 
+  while (i < 6)
+  {
+    V3[i] = V3[i] + Vtmp[i]; 
+    i++; 
+  }
+}
+
+void FFV2P0_2(std::complex<double> F1[], std::complex<double> V3[],
+    std::complex<double> COUP, double M2, double W2, std::complex<double> F2[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P2[4]; 
+  std::complex<double> denom; 
+  F2[0] = +F1[0] + V3[0]; 
+  F2[1] = +F1[1] + V3[1]; 
+  P2[0] = -F2[0].real(); 
+  P2[1] = -F2[1].real(); 
+  P2[2] = -F2[1].imag(); 
+  P2[3] = -F2[0].imag(); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  F2[2] = denom * cI * (F1[2] * (P2[0] * (V3[2] + V3[5]) + (P2[1] * (-1.) *
+      (V3[3] + cI * (V3[4])) + (P2[2] * (+cI * (V3[3]) - V3[4]) - P2[3] *
+      (V3[2] + V3[5])))) + F1[3] * (P2[0] * (V3[3] - cI * (V3[4])) + (P2[1] *
+      (-V3[2] + V3[5]) + (P2[2] * (+cI * (V3[2]) - cI * (V3[5])) + P2[3] *
+      (-V3[3] + cI * (V3[4]))))));
+  F2[3] = denom * cI * (F1[2] * (P2[0] * (V3[3] + cI * (V3[4])) + (P2[1] *
+      (-1.) * (V3[2] + V3[5]) + (P2[2] * (-1.) * (+cI * (V3[2] + V3[5])) +
+      P2[3] * (V3[3] + cI * (V3[4]))))) + F1[3] * (P2[0] * (V3[2] - V3[5]) +
+      (P2[1] * (-V3[3] + cI * (V3[4])) + (P2[2] * (-1.) * (+cI * (V3[3]) +
+      V3[4]) + P2[3] * (V3[2] - V3[5])))));
+  F2[4] = denom * - cI * M2 * (F1[2] * (-1.) * (V3[2] + V3[5]) + F1[3] *
+      (-V3[3] + cI * (V3[4])));
+  F2[5] = denom * cI * M2 * (F1[2] * (V3[3] + cI * (V3[4])) + F1[3] * (V3[2] -
+      V3[5]));
+}
+
+
+void FFV2P0_1(std::complex<double> F2[], std::complex<double> V3[],
+    std::complex<double> COUP, double M1, double W1, std::complex<double> F1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P1[4]; 
+  std::complex<double> denom; 
+  F1[0] = +F2[0] + V3[0]; 
+  F1[1] = +F2[1] + V3[1]; 
+  P1[0] = -F1[0].real(); 
+  P1[1] = -F1[1].real(); 
+  P1[2] = -F1[1].imag(); 
+  P1[3] = -F1[0].imag(); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  F1[2] = denom * cI * M1 * (F2[4] * (V3[2] + V3[5]) + F2[5] * (V3[3] + cI *
+      (V3[4])));
+  F1[3] = denom * - cI * M1 * (F2[4] * (-V3[3] + cI * (V3[4])) + F2[5] *
+      (-V3[2] + V3[5]));
+  F1[4] = denom * (-cI) * (F2[4] * (P1[0] * (V3[2] + V3[5]) + (P1[1] * (-V3[3]
+      + cI * (V3[4])) + (P1[2] * (-1.) * (+cI * (V3[3]) + V3[4]) - P1[3] *
+      (V3[2] + V3[5])))) + F2[5] * (P1[0] * (V3[3] + cI * (V3[4])) + (P1[1] *
+      (-V3[2] + V3[5]) + (P1[2] * (-cI * (V3[2]) + cI * (V3[5])) - P1[3] *
+      (V3[3] + cI * (V3[4]))))));
+  F1[5] = denom * (-cI) * (F2[4] * (P1[0] * (V3[3] - cI * (V3[4])) + (P1[1] *
+      (-1.) * (V3[2] + V3[5]) + (P1[2] * (+cI * (V3[2] + V3[5])) + P1[3] *
+      (V3[3] - cI * (V3[4]))))) + F2[5] * (P1[0] * (V3[2] - V3[5]) + (P1[1] *
+      (-1.) * (V3[3] + cI * (V3[4])) + (P1[2] * (+cI * (V3[3]) - V3[4]) + P1[3]
+      * (V3[2] - V3[5])))));
+}
+
+
+void FFV3_0(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> V3[], std::complex<double> COUP, std::complex<double>
+    & vertex)
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  std::complex<double> TMP6; 
+  TMP6 = (F1[4] * (F2[2] * (V3[2] - V3[5]) - F2[3] * (V3[3] + cI * (V3[4]))) +
+      F1[5] * (F2[2] * (-V3[3] + cI * (V3[4])) + F2[3] * (V3[2] + V3[5])));
+  vertex = COUP * - cI * TMP6; 
+}
+
+
+void FFV3_1(std::complex<double> F2[], std::complex<double> V3[],
+    std::complex<double> COUP, double M1, double W1, std::complex<double> F1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P1[4]; 
+  std::complex<double> denom; 
+  F1[0] = +F2[0] + V3[0]; 
+  F1[1] = +F2[1] + V3[1]; 
+  P1[0] = -F1[0].real(); 
+  P1[1] = -F1[1].real(); 
+  P1[2] = -F1[1].imag(); 
+  P1[3] = -F1[0].imag(); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  F1[2] = denom * (-cI) * (F2[2] * (P1[0] * (V3[2] - V3[5]) + (P1[1] * (-V3[3]
+      + cI * (V3[4])) + (P1[2] * (-1.) * (+cI * (V3[3]) + V3[4]) + P1[3] *
+      (V3[2] - V3[5])))) + F2[3] * (P1[0] * (-1.) * (V3[3] + cI * (V3[4])) +
+      (P1[1] * (V3[2] + V3[5]) + (P1[2] * (+cI * (V3[2] + V3[5])) - P1[3] *
+      (V3[3] + cI * (V3[4]))))));
+  F1[3] = denom * (-cI) * (F2[2] * (P1[0] * (-V3[3] + cI * (V3[4])) + (P1[1] *
+      (V3[2] - V3[5]) + (P1[2] * (-cI * (V3[2]) + cI * (V3[5])) + P1[3] *
+      (V3[3] - cI * (V3[4]))))) + F2[3] * (P1[0] * (V3[2] + V3[5]) + (P1[1] *
+      (-1.) * (V3[3] + cI * (V3[4])) + (P1[2] * (+cI * (V3[3]) - V3[4]) - P1[3]
+      * (V3[2] + V3[5])))));
+  F1[4] = denom * - cI * M1 * (F2[2] * (-V3[2] + V3[5]) + F2[3] * (V3[3] + cI *
+      (V3[4])));
+  F1[5] = denom * cI * M1 * (F2[2] * (-V3[3] + cI * (V3[4])) + F2[3] * (V3[2] +
+      V3[5]));
+}
+
+
+void FFV3_2(std::complex<double> F1[], std::complex<double> V3[],
+    std::complex<double> COUP, double M2, double W2, std::complex<double> F2[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P2[4]; 
+  std::complex<double> denom; 
+  F2[0] = +F1[0] + V3[0]; 
+  F2[1] = +F1[1] + V3[1]; 
+  P2[0] = -F2[0].real(); 
+  P2[1] = -F2[1].real(); 
+  P2[2] = -F2[1].imag(); 
+  P2[3] = -F2[0].imag(); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  F2[2] = denom * cI * M2 * (F1[4] * (V3[2] - V3[5]) + F1[5] * (-V3[3] + cI *
+      (V3[4])));
+  F2[3] = denom * - cI * M2 * (F1[4] * (V3[3] + cI * (V3[4])) - F1[5] * (V3[2]
+      + V3[5]));
+  F2[4] = denom * cI * (F1[4] * (P2[0] * (V3[2] - V3[5]) + (P2[1] * (-1.) *
+      (V3[3] + cI * (V3[4])) + (P2[2] * (+cI * (V3[3]) - V3[4]) + P2[3] *
+      (V3[2] - V3[5])))) + F1[5] * (P2[0] * (-V3[3] + cI * (V3[4])) + (P2[1] *
+      (V3[2] + V3[5]) + (P2[2] * (-1.) * (+cI * (V3[2] + V3[5])) + P2[3] *
+      (-V3[3] + cI * (V3[4]))))));
+  F2[5] = denom * cI * (F1[4] * (P2[0] * (-1.) * (V3[3] + cI * (V3[4])) +
+      (P2[1] * (V3[2] - V3[5]) + (P2[2] * (+cI * (V3[2]) - cI * (V3[5])) +
+      P2[3] * (V3[3] + cI * (V3[4]))))) + F1[5] * (P2[0] * (V3[2] + V3[5]) +
+      (P2[1] * (-V3[3] + cI * (V3[4])) + (P2[2] * (-1.) * (+cI * (V3[3]) +
+      V3[4]) - P2[3] * (V3[2] + V3[5])))));
+}
+
+
+void FFV3_3(std::complex<double> F1[], std::complex<double> F2[],
+    std::complex<double> COUP, double M3, double W3, std::complex<double> V3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM3; 
+  double P3[4]; 
+  std::complex<double> TMP7; 
+  std::complex<double> denom; 
+  OM3 = 0.; 
+  if (M3 != 0.)
+    OM3 = 1./(M3 * M3); 
+  V3[0] = +F1[0] + F2[0]; 
+  V3[1] = +F1[1] + F2[1]; 
+  P3[0] = -V3[0].real(); 
+  P3[1] = -V3[1].real(); 
+  P3[2] = -V3[1].imag(); 
+  P3[3] = -V3[0].imag(); 
+  TMP7 = (F1[4] * (F2[2] * (P3[0] - P3[3]) - F2[3] * (P3[1] + cI * (P3[2]))) +
+      F1[5] * (F2[2] * (-P3[1] + cI * (P3[2])) + F2[3] * (P3[0] + P3[3])));
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  V3[2] = denom * (-cI) * (F2[2] * F1[4] + F2[3] * F1[5] - P3[0] * OM3 * TMP7); 
+  V3[3] = denom * (-cI) * (F2[3] * F1[4] + F2[2] * F1[5] - P3[1] * OM3 * TMP7); 
+  V3[4] = denom * (-cI) * (+cI * (F2[3] * F1[4]) - cI * (F2[2] * F1[5]) - P3[2]
+      * OM3 * TMP7);
+  V3[5] = denom * (-cI) * (F2[2] * F1[4] - F2[3] * F1[5] - P3[3] * OM3 * TMP7); 
+}
+
+
+void VSS1_0(std::complex<double> V1[], std::complex<double> S2[],
+    std::complex<double> S3[], std::complex<double> COUP, std::complex<double>
+    & vertex)
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P2[4]; 
+  std::complex<double> TMP8; 
+  P2[0] = S2[0].real(); 
+  P2[1] = S2[1].real(); 
+  P2[2] = S2[1].imag(); 
+  P2[3] = S2[0].imag(); 
+  TMP8 = (P2[0] * V1[2] - P2[1] * V1[3] - P2[2] * V1[4] - P2[3] * V1[5]); 
+  vertex = COUP * - cI * TMP8 * S3[2] * S2[2]; 
+}
+
+void VSS1_2_0(std::complex<double> V1[], std::complex<double> S2[],
+    std::complex<double> S3[], std::complex<double> COUP1, std::complex<double>
+    COUP2, std::complex<double> & vertex)
+{
+  double P2[4]; 
+  std::complex<double> tmp; 
+  VSS1_0(V1, S2, S3, COUP1, vertex); 
+  VSS2_0(V1, S2, S3, COUP2, tmp); 
+  vertex = vertex + tmp; 
+}
+
+void VSS1_1(std::complex<double> S2[], std::complex<double> S3[],
+    std::complex<double> COUP, double M1, double W1, std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM1; 
+  double P1[4]; 
+  double P2[4]; 
+  std::complex<double> TMP9; 
+  std::complex<double> denom; 
+  OM1 = 0.; 
+  if (M1 != 0.)
+    OM1 = 1./(M1 * M1); 
+  P2[0] = S2[0].real(); 
+  P2[1] = S2[1].real(); 
+  P2[2] = S2[1].imag(); 
+  P2[3] = S2[0].imag(); 
+  V1[0] = +S2[0] + S3[0]; 
+  V1[1] = +S2[1] + S3[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  TMP9 = (P1[0] * P2[0] - P1[1] * P2[1] - P1[2] * P2[2] - P1[3] * P2[3]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * S2[2] * S3[2] * (-cI * (P2[0]) + cI * (P1[0] * OM1 * TMP9)); 
+  V1[3] = denom * S2[2] * S3[2] * (-cI * (P2[1]) + cI * (P1[1] * OM1 * TMP9)); 
+  V1[4] = denom * S2[2] * S3[2] * (-cI * (P2[2]) + cI * (P1[2] * OM1 * TMP9)); 
+  V1[5] = denom * S2[2] * S3[2] * (-cI * (P2[3]) + cI * (P1[3] * OM1 * TMP9)); 
+}
+
+void VSS1_2_1(std::complex<double> S2[], std::complex<double> S3[],
+    std::complex<double> COUP1, std::complex<double> COUP2, double M1, double
+    W1, std::complex<double> V1[])
+{
+  double P2[4]; 
+  std::complex<double> Vtmp[6]; 
+  int i; 
+  VSS1_1(S2, S3, COUP1, M1, W1, V1); 
+  VSS2_1(S2, S3, COUP2, M1, W1, Vtmp); 
+  i = 2; 
+  while (i < 6)
+  {
+    V1[i] = V1[i] + Vtmp[i]; 
+    i++; 
+  }
+}
+
+void VSS1_2(std::complex<double> V1[], std::complex<double> S3[],
+    std::complex<double> COUP, double M2, double W2, std::complex<double> S2[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P2[4]; 
+  std::complex<double> TMP8; 
+  std::complex<double> denom; 
+  S2[0] = +V1[0] + S3[0]; 
+  S2[1] = +V1[1] + S3[1]; 
+  P2[0] = -S2[0].real(); 
+  P2[1] = -S2[1].real(); 
+  P2[2] = -S2[1].imag(); 
+  P2[3] = -S2[0].imag(); 
+  TMP8 = (P2[0] * V1[2] - P2[1] * V1[3] - P2[2] * V1[4] - P2[3] * V1[5]); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  S2[2] = denom * cI * TMP8 * S3[2]; 
+}
+
+void VSS1_2_2(std::complex<double> V1[], std::complex<double> S3[],
+    std::complex<double> COUP1, std::complex<double> COUP2, double M2, double
+    W2, std::complex<double> S2[])
+{
+  std::complex<double> Stmp[3]; 
+  int i; 
+  VSS1_2(V1, S3, COUP1, M2, W2, S2); 
+  VSS2_2(V1, S3, COUP2, M2, W2, Stmp); 
+  i = 2; 
+  while (i < 3)
+  {
+    S2[i] = S2[i] + Stmp[i]; 
+    i++; 
+  }
+}
+
+void VSS1_3(std::complex<double> V1[], std::complex<double> S2[],
+    std::complex<double> COUP, double M3, double W3, std::complex<double> S3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P2[4]; 
+  double P3[4]; 
+  std::complex<double> TMP8; 
+  std::complex<double> denom; 
+  P2[0] = S2[0].real(); 
+  P2[1] = S2[1].real(); 
+  P2[2] = S2[1].imag(); 
+  P2[3] = S2[0].imag(); 
+  S3[0] = +V1[0] + S2[0]; 
+  S3[1] = +V1[1] + S2[1]; 
+  P3[0] = -S3[0].real(); 
+  P3[1] = -S3[1].real(); 
+  P3[2] = -S3[1].imag(); 
+  P3[3] = -S3[0].imag(); 
+  TMP8 = (P2[0] * V1[2] - P2[1] * V1[3] - P2[2] * V1[4] - P2[3] * V1[5]); 
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  S3[2] = denom * cI * TMP8 * S2[2]; 
+}
+
+void VSS1_2_3(std::complex<double> V1[], std::complex<double> S2[],
+    std::complex<double> COUP1, std::complex<double> COUP2, double M3, double
+    W3, std::complex<double> S3[])
+{
+  double P2[4]; 
+  std::complex<double> Stmp[3]; 
+  int i; 
+  VSS1_3(V1, S2, COUP1, M3, W3, S3); 
+  VSS2_3(V1, S2, COUP2, M3, W3, Stmp); 
+  i = 2; 
+  while (i < 3)
+  {
+    S3[i] = S3[i] + Stmp[i]; 
+    i++; 
+  }
+}
+
+void VSS1P0_1(std::complex<double> S2[], std::complex<double> S3[],
+    std::complex<double> COUP, double M1, double W1, std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P1[4]; 
+  double P2[4]; 
+  std::complex<double> denom; 
+  P2[0] = S2[0].real(); 
+  P2[1] = S2[1].real(); 
+  P2[2] = S2[1].imag(); 
+  P2[3] = S2[0].imag(); 
+  V1[0] = +S2[0] + S3[0]; 
+  V1[1] = +S2[1] + S3[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * - cI * P2[0] * S3[2] * S2[2]; 
+  V1[3] = denom * - cI * P2[1] * S3[2] * S2[2]; 
+  V1[4] = denom * - cI * P2[2] * S3[2] * S2[2]; 
+  V1[5] = denom * - cI * P2[3] * S3[2] * S2[2]; 
+}
+
+
+void VSS2_0(std::complex<double> V1[], std::complex<double> S2[],
+    std::complex<double> S3[], std::complex<double> COUP, std::complex<double>
+    & vertex)
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P3[4]; 
+  std::complex<double> TMP10; 
+  P3[0] = S3[0].real(); 
+  P3[1] = S3[1].real(); 
+  P3[2] = S3[1].imag(); 
+  P3[3] = S3[0].imag(); 
+  TMP10 = (P3[0] * V1[2] - P3[1] * V1[3] - P3[2] * V1[4] - P3[3] * V1[5]); 
+  vertex = COUP * - cI * TMP10 * S3[2] * S2[2]; 
+}
+
+
+void VSS2_1(std::complex<double> S2[], std::complex<double> S3[],
+    std::complex<double> COUP, double M1, double W1, std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double OM1; 
+  double P1[4]; 
+  double P3[4]; 
+  std::complex<double> TMP11; 
+  std::complex<double> denom; 
+  OM1 = 0.; 
+  if (M1 != 0.)
+    OM1 = 1./(M1 * M1); 
+  P3[0] = S3[0].real(); 
+  P3[1] = S3[1].real(); 
+  P3[2] = S3[1].imag(); 
+  P3[3] = S3[0].imag(); 
+  V1[0] = +S2[0] + S3[0]; 
+  V1[1] = +S2[1] + S3[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  TMP11 = (P1[0] * P3[0] - P1[1] * P3[1] - P1[2] * P3[2] - P1[3] * P3[3]); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * S2[2] * S3[2] * (-cI * (P3[0]) + cI * (P1[0] * OM1 * TMP11)); 
+  V1[3] = denom * S2[2] * S3[2] * (-cI * (P3[1]) + cI * (P1[1] * OM1 * TMP11)); 
+  V1[4] = denom * S2[2] * S3[2] * (-cI * (P3[2]) + cI * (P1[2] * OM1 * TMP11)); 
+  V1[5] = denom * S2[2] * S3[2] * (-cI * (P3[3]) + cI * (P1[3] * OM1 * TMP11)); 
+}
+
+
+void VSS2_2(std::complex<double> V1[], std::complex<double> S3[],
+    std::complex<double> COUP, double M2, double W2, std::complex<double> S2[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P2[4]; 
+  double P3[4]; 
+  std::complex<double> TMP10; 
+  std::complex<double> denom; 
+  P3[0] = S3[0].real(); 
+  P3[1] = S3[1].real(); 
+  P3[2] = S3[1].imag(); 
+  P3[3] = S3[0].imag(); 
+  S2[0] = +V1[0] + S3[0]; 
+  S2[1] = +V1[1] + S3[1]; 
+  P2[0] = -S2[0].real(); 
+  P2[1] = -S2[1].real(); 
+  P2[2] = -S2[1].imag(); 
+  P2[3] = -S2[0].imag(); 
+  TMP10 = (P3[0] * V1[2] - P3[1] * V1[3] - P3[2] * V1[4] - P3[3] * V1[5]); 
+  denom = COUP/((P2[0] * P2[0]) - (P2[1] * P2[1]) - (P2[2] * P2[2]) - (P2[3] *
+      P2[3]) - M2 * (M2 - cI * W2));
+  S2[2] = denom * cI * TMP10 * S3[2]; 
+}
+
+
+void VSS2_3(std::complex<double> V1[], std::complex<double> S2[],
+    std::complex<double> COUP, double M3, double W3, std::complex<double> S3[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P3[4]; 
+  std::complex<double> TMP10; 
+  std::complex<double> denom; 
+  S3[0] = +V1[0] + S2[0]; 
+  S3[1] = +V1[1] + S2[1]; 
+  P3[0] = -S3[0].real(); 
+  P3[1] = -S3[1].real(); 
+  P3[2] = -S3[1].imag(); 
+  P3[3] = -S3[0].imag(); 
+  TMP10 = (P3[0] * V1[2] - P3[1] * V1[3] - P3[2] * V1[4] - P3[3] * V1[5]); 
+  denom = COUP/((P3[0] * P3[0]) - (P3[1] * P3[1]) - (P3[2] * P3[2]) - (P3[3] *
+      P3[3]) - M3 * (M3 - cI * W3));
+  S3[2] = denom * cI * TMP10 * S2[2]; 
+}
+
+
+void VSS2P0_1(std::complex<double> S2[], std::complex<double> S3[],
+    std::complex<double> COUP, double M1, double W1, std::complex<double> V1[])
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  double P1[4]; 
+  double P3[4]; 
+  std::complex<double> denom; 
+  P3[0] = S3[0].real(); 
+  P3[1] = S3[1].real(); 
+  P3[2] = S3[1].imag(); 
+  P3[3] = S3[0].imag(); 
+  V1[0] = +S2[0] + S3[0]; 
+  V1[1] = +S2[1] + S3[1]; 
+  P1[0] = -V1[0].real(); 
+  P1[1] = -V1[1].real(); 
+  P1[2] = -V1[1].imag(); 
+  P1[3] = -V1[0].imag(); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  V1[2] = denom * - cI * P3[0] * S3[2] * S2[2]; 
+  V1[3] = denom * - cI * P3[1] * S3[2] * S2[2]; 
+  V1[4] = denom * - cI * P3[2] * S3[2] * S2[2]; 
+  V1[5] = denom * - cI * P3[3] * S3[2] * S2[2]; 
+}
+
+
+void VVS1_0(std::complex<double> V1[], std::complex<double> V2[],
+    std::complex<double> S3[], std::complex<double> COUP, std::complex<double>
+    & vertex)
+{
+  static std::complex<double> cI = std::complex<double> (0., 1.); 
+  std::complex<double> TMP12; 
+  TMP12 = (V1[2] * V2[2] - V1[3] * V2[3] - V1[4] * V2[4] - V1[5] * V2[5]); 
