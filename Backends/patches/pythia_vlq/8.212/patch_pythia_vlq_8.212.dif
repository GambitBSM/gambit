+  VVV1_0(V1, V2, V3, COUP1, vertex); 
+  VVV2_0(V1, V2, V3, COUP2, tmp); 
+  vertex = vertex + tmp; 
+  VVV3_0(V1, V2, V3, COUP3, tmp); 
+  vertex = vertex + tmp; 
+  VVV4_0(V1, V2, V3, COUP4, tmp); 
+  vertex = vertex + tmp; 
+  VVV5_0(V1, V2, V3, COUP5, tmp); 
+  vertex = vertex + tmp; 
