+  GC_110 = (mdl_ee * mdl_complexi * mdl_KTLz1)/(2. * mdl_cw * mdl_sw); 
+  GC_111 = (mdl_ee * mdl_complexi * mdl_KTLz2)/(2. * mdl_cw * mdl_sw); 
+  GC_112 = (mdl_ee * mdl_complexi * mdl_KTLz3)/(2. * mdl_cw * mdl_sw); 
+  GC_113 = (mdl_ee * mdl_complexi * mdl_KTRw1)/(mdl_sw * mdl_sqrt__2); 
+  GC_114 = (mdl_ee * mdl_complexi * mdl_KTRw2)/(mdl_sw * mdl_sqrt__2); 
+  GC_115 = (mdl_ee * mdl_complexi * mdl_KTRw3)/(mdl_sw * mdl_sqrt__2); 
+  GC_116 = (mdl_ee * mdl_complexi * mdl_KTRz1)/(2. * mdl_cw * mdl_sw); 
+  GC_117 = (mdl_ee * mdl_complexi * mdl_KTRz2)/(2. * mdl_cw * mdl_sw); 
+  GC_118 = (mdl_ee * mdl_complexi * mdl_KTRz3)/(2. * mdl_cw * mdl_sw); 
+  GC_119 = (mdl_ee * mdl_complexi * mdl_KXL1)/(mdl_sw * mdl_sqrt__2); 
+  GC_120 = (mdl_ee * mdl_complexi * mdl_KXL2)/(mdl_sw * mdl_sqrt__2); 
+  GC_121 = (mdl_ee * mdl_complexi * mdl_KXL3)/(mdl_sw * mdl_sqrt__2); 
+  GC_122 = (mdl_ee * mdl_complexi * mdl_KXR1)/(mdl_sw * mdl_sqrt__2); 
+  GC_123 = (mdl_ee * mdl_complexi * mdl_KXR2)/(mdl_sw * mdl_sqrt__2); 
+  GC_124 = (mdl_ee * mdl_complexi * mdl_KXR3)/(mdl_sw * mdl_sqrt__2); 
+  GC_125 = (mdl_ee * mdl_complexi * mdl_KYL1)/(mdl_sw * mdl_sqrt__2); 
+  GC_126 = (mdl_ee * mdl_complexi * mdl_KYL2)/(mdl_sw * mdl_sqrt__2); 
+  GC_127 = (mdl_ee * mdl_complexi * mdl_KYL3)/(mdl_sw * mdl_sqrt__2); 
+  GC_128 = (mdl_ee * mdl_complexi * mdl_KYR1)/(mdl_sw * mdl_sqrt__2); 
+  GC_129 = (mdl_ee * mdl_complexi * mdl_KYR2)/(mdl_sw * mdl_sqrt__2); 
+  GC_130 = (mdl_ee * mdl_complexi * mdl_KYR3)/(mdl_sw * mdl_sqrt__2); 
+  GC_131 = (mdl_ee * mdl_complexi * mdl_sw)/(3. * mdl_cw); 
+  GC_132 = (-2. * mdl_ee * mdl_complexi * mdl_sw)/(3. * mdl_cw); 
+  GC_133 = (mdl_ee * mdl_complexi * mdl_sw)/mdl_cw; 
+  GC_134 = -0.5 * (mdl_cw * mdl_ee)/mdl_sw - (mdl_ee * mdl_sw)/(2. * mdl_cw); 
+  GC_135 = -0.5 * (mdl_cw * mdl_ee * mdl_complexi)/mdl_sw - (mdl_ee *
+      mdl_complexi * mdl_sw)/(6. * mdl_cw);
+  GC_136 = (mdl_cw * mdl_ee * mdl_complexi)/(2. * mdl_sw) - (mdl_ee *
+      mdl_complexi * mdl_sw)/(6. * mdl_cw);
+  GC_137 = (mdl_cw * mdl_ee * mdl_complexi)/(2. * mdl_sw) - (mdl_ee *
+      mdl_complexi * mdl_sw)/(2. * mdl_cw);
+  GC_138 = -0.5 * (mdl_cw * mdl_ee * mdl_complexi)/mdl_sw + (mdl_ee *
+      mdl_complexi * mdl_sw)/(2. * mdl_cw);
+  GC_139 = (mdl_cw * mdl_ee * mdl_complexi)/(2. * mdl_sw) + (mdl_ee *
+      mdl_complexi * mdl_sw)/(2. * mdl_cw);
+  GC_140 = (mdl_cw * mdl_ee)/(2. * mdl_sw) + (mdl_ee * mdl_sw)/(2. * mdl_cw); 
+  GC_141 = (mdl_cw * mdl_ee__exp__2 * mdl_complexi)/mdl_sw - (mdl_ee__exp__2 *
+      mdl_complexi * mdl_sw)/mdl_cw;
+  GC_142 = -(mdl_ee__exp__2 * mdl_complexi) + (mdl_cw__exp__2 * mdl_ee__exp__2
+      * mdl_complexi)/(2. * mdl_sw__exp__2) + (mdl_ee__exp__2 * mdl_complexi *
+      mdl_sw__exp__2)/(2. * mdl_cw__exp__2);
+  GC_143 = mdl_ee__exp__2 * mdl_complexi + (mdl_cw__exp__2 * mdl_ee__exp__2 *
+      mdl_complexi)/(2. * mdl_sw__exp__2) + (mdl_ee__exp__2 * mdl_complexi *
+      mdl_sw__exp__2)/(2. * mdl_cw__exp__2);
+  GC_144 = -0.5 * (mdl_ee__exp__2 * mdl_vev)/mdl_cw; 
+  GC_145 = (mdl_ee__exp__2 * mdl_vev)/(2. * mdl_cw); 
+  GC_146 = -2. * mdl_complexi * mdl_lam * mdl_vev; 
+  GC_147 = -6. * mdl_complexi * mdl_lam * mdl_vev; 
+  GC_148 = -0.25 * (mdl_ee__exp__2 * mdl_vev)/mdl_sw__exp__2; 
+  GC_149 = -0.25 * (mdl_ee__exp__2 * mdl_complexi * mdl_vev)/mdl_sw__exp__2; 
+  GC_150 = (mdl_ee__exp__2 * mdl_complexi * mdl_vev)/(2. * mdl_sw__exp__2); 
+  GC_151 = (mdl_ee__exp__2 * mdl_vev)/(4. * mdl_sw__exp__2); 
+  GC_152 = -0.5 * (mdl_ee__exp__2 * mdl_vev)/mdl_sw; 
+  GC_153 = (mdl_ee__exp__2 * mdl_vev)/(2. * mdl_sw); 
+  GC_154 = -0.25 * (mdl_ee__exp__2 * mdl_vev)/mdl_cw - (mdl_cw * mdl_ee__exp__2
+      * mdl_vev)/(4. * mdl_sw__exp__2);
+  GC_155 = (mdl_ee__exp__2 * mdl_vev)/(4. * mdl_cw) - (mdl_cw * mdl_ee__exp__2
+      * mdl_vev)/(4. * mdl_sw__exp__2);
+  GC_156 = -0.25 * (mdl_ee__exp__2 * mdl_vev)/mdl_cw + (mdl_cw * mdl_ee__exp__2
+      * mdl_vev)/(4. * mdl_sw__exp__2);
+  GC_157 = (mdl_ee__exp__2 * mdl_vev)/(4. * mdl_cw) + (mdl_cw * mdl_ee__exp__2
+      * mdl_vev)/(4. * mdl_sw__exp__2);
+  GC_158 = -0.5 * (mdl_ee__exp__2 * mdl_complexi * mdl_vev) - (mdl_cw__exp__2 *
+      mdl_ee__exp__2 * mdl_complexi * mdl_vev)/(4. * mdl_sw__exp__2) -
+      (mdl_ee__exp__2 * mdl_complexi * mdl_sw__exp__2 * mdl_vev)/(4. *
+      mdl_cw__exp__2);
+  GC_159 = mdl_ee__exp__2 * mdl_complexi * mdl_vev + (mdl_cw__exp__2 *
+      mdl_ee__exp__2 * mdl_complexi * mdl_vev)/(2. * mdl_sw__exp__2) +
+      (mdl_ee__exp__2 * mdl_complexi * mdl_sw__exp__2 * mdl_vev)/(2. *
+      mdl_cw__exp__2);
