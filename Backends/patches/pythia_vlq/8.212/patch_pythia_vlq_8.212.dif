+      (TMP26))))));
+  V3[5] = denom * (-1.) * (P3[3] * (OM3 * (TMP26 * (+cI * (TMP10) + 3./17. * cI
+      * (TMP5) + 3./17. * cI * (TMP24)) + (TMP9 * (-1.) * (+cI * (TMP27) -
