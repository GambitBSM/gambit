+  F1[1] = +F2[1]; 
+  P1[0] = -F1[0].real(); 
+  P1[1] = -F1[1].real(); 
+  P1[2] = -F1[1].imag(); 
+  P1[3] = -F1[0].imag(); 
+  denom = COUP/((P1[0] * P1[0]) - (P1[1] * P1[1]) - (P1[2] * P1[2]) - (P1[3] *
+      P1[3]) - M1 * (M1 - cI * W1));
+  F1[2] = denom * 0.; 
+  F1[3] = denom * 0.; 
+  F1[4] = denom * 0.; 
+  F1[5] = denom * 0.; 
+}
