+      V4[2]))) + (P1[2] * (V2[2] * (-V3[3] * V4[5] + V3[5] * V4[3]) + (V2[3] *
+      (V3[2] * V4[5] - V3[5] * V4[2]) + V2[5] * (-V3[2] * V4[3] + V3[3] *
+      V4[2]))) + P1[3] * (V2[2] * (V3[3] * V4[4] - V3[4] * V4[3]) + (V2[3] *
+      (-V3[2] * V4[4] + V3[4] * V4[2]) + V2[4] * (V3[2] * V4[3] - V3[3] *
+      V4[2]))))));
