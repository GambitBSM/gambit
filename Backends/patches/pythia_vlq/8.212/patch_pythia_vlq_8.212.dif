+#==========================================================================
+# This file has been automatically generated for Pythia 8 by
+#  MadGraph5_aMC@NLO v. 2.8.3.2, 2021-02-02
+#  By the MadGraph5_aMC@NLO Development Team
+#  Visit launchpad.net/madgraph5 and amcatnlo.web.cern.ch
+#==========================================================================
+
+SHELL = /bin/sh
+
+-include Makefile.inc
+
+# flags:
+#
+#FFLAGSSHARED = -fPIC
+CFLAGSSHARED = -fPIC
+CXXFLAGSSHARED = -fPIC
+
+# Location of directories.
+TMPDIR=../tmp
+INCDIR1=include
+INCDIR2=Processes_VLQ
+SRCDIR=.
+LIBDIR=lib
+LIBDIRARCH=lib/archive
+PROCDIR=Processes_VLQ
+
+all: $(targets) 
+
+CPPFLAGS= -I../$(INCDIR1) -I../$(INCDIR2)
+LIBS=-L../$(LIBDIRARCH) -L../lib -lpythia8 -l$(PROCDIR) -lz
+
+all: main_VLQ_1
+
+main_VLQ_1: main_VLQ_1.o ../$(LIBDIRARCH)/lib$(PROCDIR).a
+	$(CXX) -o main_VLQ_1 main_VLQ_1.o $(LIBS)
+
+../$(LIBDIRARCH)/lib$(PROCDIR).a: ../$(PROCDIR)/Makefile
+	cd ../$(PROCDIR); make
