--- /dev/null	2026-04-24 11:39:11.973366589 +0200
+++ b/src/sushi/sushi_gambit_interface.f	2026-05-06 00:00:00.000000000 +0200
@@ -0,0 +1,73 @@
+C     GAMBIT interface subroutines for SusHi 1.7.0
+C     Sets jfilein in SusHi common block and runs cross-section computation.
+
+C-{{{ gambit_sushi_setfile
+      subroutine gambit_sushi_setfile(fn, n)
+C     Sets jfilein in SusHi common /fileinfileout/ from a C char* buffer.
+C     fn: character*1 array of length n (no hidden Fortran length argument)
+C     n:  length of fn buffer
+      implicit none
+      integer n
+      character*1 fn(n)
+      character*60 jfilein, jfnameact
+      common /fileinfileout/ jfilein, jfnameact
+      integer i
+      jfilein = ' '
+      do i = 1, min(n, 60)
+        jfilein(i:i) = fn(i)
+      end do
+C     Derive jfnameact from the input filename by stripping .slha extension.
+C     SusHi appends _murdep to jfnameact when muranalytic is true; the result
+C     must be a writable path.  '/dev/null' would produce '/dev/null_murdep'
+C     which does not exist and causes a runtime error.
+      jfnameact = jfilein
+      i = index(jfnameact, '.slha')
+      if (i .gt. 0) jfnameact(i:60) = ' '
+      return
+      end
+C-}}}
+
+C-{{{ gambit_sushi_compute
+      subroutine gambit_sushi_compute(ggh_result, bbh_result)
+C     Runs SusHi ggh+bbh cross-section computation.
+C     Assumes jfilein has already been set via gambit_sushi_setfile.
+C     Returns xeff (ggh NNLO effective, pb) and SUbbh(3) (bbh NNLO, pb).
+      implicit none
+      double precision ggh_result, bbh_result
+      double precision SUggh(4,4,-1:5), SUggherr(4,4,-1:5)
+      double precision SUbbh(4), SUbbherr(4)
+      double precision ggchan, qgchan, qqchan
+      double precision ggchanerr, qgchanerr, qqchanerr
+      double precision xsec(2), xsecerr(2), xeff, xefferr, elw
+      double precision xeffvar(2), gghXSvar(2)
+      double complex gb13o, gbh123o, gbh213o, gb23o
+      double complex gt13o, gth123o, gth213o, gt23o
+      double complex gb3o, gt3o
+      include '../commons/common-inputoutput.f'
+      include '../commons/common-flags.f'
+      include '../commons/common-vars.f'
+      include '../commons/common-keys.f'
+      include '../commons/common-quark.f'
+      include '../commons/common-int.f'
+      include '../commons/common-ren.f'
+C     Use extflag=.false. so initsushi reads the full SLHA file including
+C     the SUSHI block (energy, order, scale factors).  extflag=.true. is
+C     for FeynHiggs/2HDMC external-program mode and skips those reads,
+C     leaving murfacggh uninitialised (=0), which causes runalpha(mu=0).
+      extflag = .false.
+      call initsushi(0)
+      call cutssushi()
+      call coresushi(0,
+     & SUggh, SUggherr, SUbbh, SUbbherr,
+     & ggchan, qgchan, qqchan,
+     & ggchanerr, qgchanerr, qqchanerr,
+     & xsec, xeff, xsecerr, xefferr,
+     & xeffvar, gghXSvar, elw,
+     & gb13o, gbh123o, gbh213o, gb23o,
+     & gt13o, gth123o, gth213o, gt23o,
+     & gb3o, gt3o)
+      ggh_result = xeff
+      bbh_result = SUbbh(3)
+      return
+      end
+C-}}}
