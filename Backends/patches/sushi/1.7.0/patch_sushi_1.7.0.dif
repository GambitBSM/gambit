--- a/src/sushi/sushi_gambit_interface.f
+++ b/src/sushi/sushi_gambit_interface.f
@@ -0,0 +1,225 @@
+C     GAMBIT interface subroutines for SusHi 1.7.0
+C
+C     The GAMBIT frontend fills SusHi's SLHA input common blocks
+C     (src/commons/common-slha.f) directly from C++ -- the same
+C     variables that readslha/slhablocks fill when parsing an input
+C     file -- and then calls gambit_sushi_compute.  That routine runs
+C     SusHi's usual initialisation and cross-section calculation with
+C     the file reading switched off ("GAMBIT in-memory mode", flag
+C     lgambitmode in common /gambitsushi/).  In this mode
+C       * readslha (readslha.f) does not touch any file and reports a
+C         block as present if any of its entries has been given,
+C       * readinsushi (inputoutput.f) neither opens nor closes an
+C         input file and does not reset the entry-given flags,
+C       * the optional _murdep output file is not written
+C         (sushicore.f, sigma.f).
+C     Everything else is SusHi's own code path, so the result is
+C     identical to that of a standalone SusHi run on an input file
+C     containing the same entries.
+
+C-{{{ gambit_sushi_compute
+      subroutine gambit_sushi_compute(ggh_result, bbh_result,
+     & ggh_err, bbh_err)
+C     Runs SusHi ggh+bbh cross-section computation on the input
+C     currently held in the SLHA common blocks.
+C     Returns xeff (ggh NNLO effective, pb) and SUbbh(3) (bbh NNLO, pb),
+C     plus their VEGAS integration errors xefferr and SUbbherr(3) (pb).
+      implicit none
+      double precision ggh_result, bbh_result
+      double precision ggh_err, bbh_err
+      double precision SUggh(4,4,-1:5), SUggherr(4,4,-1:5)
+      double precision SUbbh(4), SUbbherr(4)
+      double precision ggchan, qgchan, qqchan
+      double precision ggchanerr, qgchanerr, qqchanerr
+      double precision xsec(2), xsecerr(2), xeff, xefferr, elw
+      double precision xeffvar(2), gghXSvar(2)
+      double complex gb13o, gbh123o, gbh213o, gb23o
+      double complex gt13o, gth123o, gth213o, gt23o
+      double complex gb3o, gt3o
+      integer ninp, noutp
+      logical lgambitmode
+      include '../commons/common-inputoutput.f'
+      include '../commons/common-flags.f'
+      include '../commons/common-vars.f'
+      include '../commons/common-keys.f'
+      include '../commons/common-quark.f'
+      include '../commons/common-int.f'
+      include '../commons/common-ren.f'
+      common /vgasio/ ninp,noutp
+      common /gambitsushi/ lgambitmode
+C     Switch on the in-memory input mode (see header of this file).
+      lgambitmode = .true.
+C     No input/output files are used.  Give the names harmless
+C     non-blank values anyway (SusHi strips trailing blanks from
+C     jfnameact and must not be handed an all-blank string).
+      jfilein = 'GAMBIT'
+      jfnameact = 'GAMBIT'
+C     Any VEGAS screen output goes to stdout, as in standalone SusHi.
+      noutp = 6
+C     Use extflag=.false. so initsushi reads the full input including
+C     the SUSHI block (energy, order, scale factors).  extflag=.true. is
+C     for FeynHiggs/2HDMC external-program mode and skips those reads,
+C     leaving murfacggh uninitialised (=0), which causes runalpha(mu=0).
+      extflag = .false.
+      call initsushi(0)
+      call cutssushi()
+      call coresushi(0,
+     & SUggh, SUggherr, SUbbh, SUbbherr,
+     & ggchan, qgchan, qqchan,
+     & ggchanerr, qgchanerr, qqchanerr,
+     & xsec, xeff, xsecerr, xefferr,
+     & xeffvar, gghXSvar, elw,
+     & gb13o, gbh123o, gbh213o, gb23o,
+     & gt13o, gth123o, gth213o, gt23o,
+     & gb3o, gt3o)
+      ggh_result = xeff
+      bbh_result = SUbbh(3)
+      ggh_err = xefferr
+      bbh_err = SUbbherr(3)
+      lgambitmode = .false.
+      return
+      end
+C-}}}
+
+C-{{{ gambit_sushi_reset_ranlux
+      subroutine gambit_sushi_reset_ranlux
+C     Resets SusHi's RANLUX generator (used by VEGAS) to the state it
+C     has at the start of a fresh process (see RLUXRESET in
+C     src/share/ranlux.F), so that the next point's integration does
+C     not depend on the points computed earlier in the same process
+C     and reproduces a standalone SusHi run on the same input.
+      implicit none
+      call rluxreset
+      return
+      end
+C-}}}
+
+C-{{{ gambit_slhablock_present
+      logical function gambit_slhablock_present(blocktypin)
+C     In GAMBIT in-memory mode: is SLHA block BLOCKTYPIN present, i.e.
+C     has the GAMBIT frontend flagged at least one of its entries as
+C     given?  Mirrors the block -> common-block mapping of slhablocks.f.
+      implicit none
+      character*15 blocktypin, blocktype
+      character*1 uppercase
+      integer j
+      include '../commons/common-slha.f'
+      blocktype = blocktypin
+      do j=1,15
+         blocktype(j:j) = uppercase(blocktype(j:j))
+      enddo
+      select case (blocktype)
+      case ('SUSHI')
+         gambit_slhablock_present = any(lsushipar)
+      case ('SMINPUTS')
+         gambit_slhablock_present = any(lsminputs)
+      case ('MINPAR')
+         gambit_slhablock_present = any(lminpar)
+      case ('EXTPAR')
+         gambit_slhablock_present = any(lextpar)
+      case ('IMEXTPAR')
+         gambit_slhablock_present = any(limextpar)
+      case ('ALPHA')
+         gambit_slhablock_present = lslhaalpha
+      case ('MASS')
+         gambit_slhablock_present = any(lsmassbo) .or.
+     &        any(lsmassfe1) .or. any(lsmassfe2)
+      case ('STOPMIX')
+         gambit_slhablock_present = any(lstopmix)
+      case ('SBOTMIX')
+         gambit_slhablock_present = any(lsbotmix)
+      case ('NMHMIX')
+         gambit_slhablock_present = any(lnmhmix)
+      case ('NMAMIX')
+         gambit_slhablock_present = any(lnmamix)
+      case ('NMAMIXR')
+         gambit_slhablock_present = any(lnmamixr)
+      case ('GAUGE')
+         gambit_slhablock_present = any(lgauge)
+      case ('RENORMBOT')
+         gambit_slhablock_present = any(lrenormbotpar)
+      case ('RENORMSBOT')
+         gambit_slhablock_present = any(lrenormsbotpar)
+      case ('FACTORS')
+         gambit_slhablock_present = any(lyukawafac)
+      case ('4GEN')
+         gambit_slhablock_present = any(lfourgen)
+      case ('SCALES')
+         gambit_slhablock_present = any(lscalespar) .or.
+     &        any(lmurscanpar)
+      case ('DISTRIB')
+         gambit_slhablock_present = any(ldistribpar)
+      case ('VEGAS')
+         gambit_slhablock_present = any(lvegaspar)
+      case ('PDFSPEC')
+         gambit_slhablock_present = any(lpdfname) .or.
+     &        any(lpdfspecpar)
+      case ('FEYNHIGGS')
+         gambit_slhablock_present = any(lfeynhiggspar)
+      case ('FEYNHIGGSFLAGS')
+         gambit_slhablock_present = any(lfhflags)
+      case ('2HDMC')
+         gambit_slhablock_present = any(lthdmcpar)
+      case ('2HDM')
+         gambit_slhablock_present = ltwohdmpar
+      case ('DIM5')
+         gambit_slhablock_present = any(ldim5par) .or. ldim5runpar
+      case ('GGHSOFT')
+         gambit_slhablock_present = any(lgghsoftpar)
+      case ('GGHMT')
+         gambit_slhablock_present = any(lgghmtpar) .or.
+     &        any(lgghmtreal)
+      case ('QQH')
+         gambit_slhablock_present = any(lqqhint) .or. any(lqqhreal)
+      case ('TMP')
+         gambit_slhablock_present = any(ltmpint) .or. any(ltmpreal)
+      case ('EXTFILE')
+         gambit_slhablock_present = lextfilepar(1)
+      case default
+C        e.g. FLEXIBLESUSY: never provided by GAMBIT
+         gambit_slhablock_present = .false.
+      end select
+      return
+      end
+C-}}}
+
+C-{{{ GAMBIT error handler
+C     Fatal-error hook: every former STOP in SusHi calls gsdie, which
+C     passes the message to a C++ callback (installed by the GAMBIT
+C     frontend) that throws an exception.  STOP is kept as a fallback if
+C     no callback is installed.
+      module gambit_sushi_errors
+      use, intrinsic :: iso_c_binding
+      implicit none
+      type(c_funptr), bind(C, name="C_sushi_errorhandler_cptr") ::
+     &     errorhandler_cptr
+      abstract interface
+        subroutine callback(msg) bind(C)
+          use, intrinsic :: iso_c_binding
+          character(kind=c_char) :: msg(*)
+        end subroutine callback
+      end interface
+      end module gambit_sushi_errors
+
+      subroutine gsdie(strng)
+      use, intrinsic :: iso_c_binding
+      use gambit_sushi_errors
+      implicit none
+      character*(*) strng
+      character(kind=c_char) :: cmsg(257)
+      procedure(callback), pointer :: fptr
+      integer i, n
+      n = min(len_trim(strng), 256)
+      do i = 1, n
+        cmsg(i) = strng(i:i)
+      enddo
+      cmsg(n+1) = c_null_char
+      write(6,*) 'SusHi (fatal): ', strng(1:n)
+      if (c_associated(errorhandler_cptr)) then
+        call c_f_procpointer(errorhandler_cptr, fptr)
+        call fptr(cmsg)
+      endif
+      write(6,*) 'DEBUG: no GAMBIT error handler, stopping'
+      error stop
+      end
+C-}}}
