diff -rupN SPheno/Inert/AddLoopFunctions.f90 /home/chris-chang/WORK/GAMBIT/CoreWork/GUMIDMHelp/gambit/gum/Outputs/Inert/SPheno_patched/Inert/AddLoopFunctions.f90
--- SPheno/Inert/AddLoopFunctions.f90	2018-08-09 14:12:17.000000000 +0100
+++ /home/chris-chang/WORK/GAMBIT/CoreWork/GUMIDMHelp/gambit/gum/Outputs/Inert/SPheno_patched/Inert/AddLoopFunctions.f90	2026-02-18 15:33:43.849857274 +0000
@@ -1407,12 +1407,16 @@ End Function DerVVVloop
   VB0 = B0(xp,xm1,xm2)
   VDerB0 = SA_DerB0(xp,xm1,xm2)
 
+  If ((xm1.Eq.0._dp).And.(xm2.Eq.0._dp)) Then
+    SA_DerB00 = -2._dp * xp * xp - 3._dp * xp * xp * VB0 - 3._dp * xp * xp * xp * VDerB0
+  Else
   SA_DerB00 = 3._dp * (xm1 * xm1 - 2._dp * xm1 * xm2 &
    & + xm2 * xm2 - xp * xp) * VB0 &
    & - 3._dp * (xm1 - xm2) * (xm1 - xm2) * B0(0._dp,xm1,xm2) &
    & - 3._dp * xp * (xm1 * xm1 + xm2 * xm2 + xp * xp)* VDerB0 &
    & + 6._dp * (xm1 + xm2) * xp * xp * VDerB0 &
    & + 6._dp * xm1 * xm2 * xp * VDerB0 - 2._dp * xp * xp
+  Endif
   SA_DerB00 = SA_DerB00 / (36._dp * xp * xp)
 
   End If
